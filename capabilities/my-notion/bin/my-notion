#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = [
#     "httpx>=0.27",
#     "capabilities-contract>=0.8,<1",
# ]
# ///
"""
my-notion — agent-first CLI for Notion pages AND databases (personal, multi-workspace).

This tool is designed to be invoked by agents. Run `my-notion help` to load
the full usage contract on demand — do not rely on memorised knowledge of
its surface.

Author: Alexander Korenevski. MIT licence. Its first version started from the
`notion` capability by Konstantin Žilin in ai-cluster-one/capabilities (MIT);
it is an independent capability, not a fork (PROVENANCE.md).

CONNECTIONS
  Configuration resolves as named connections, one per Notion workspace,
  declared in an explicit registry. Declare them through the manager, from
  the project that uses them:
    capabilities set my-notion connection <id> \
      '{"secret_env": "NOTION_<ID>_TOKEN", "allow_write": true}'
    capabilities set my-notion setting connection.default <id>
  The manager writes them to the project's capabilities envelope as
  my-notion/connections.json (in a ContextKit project, `contextkit path
  capabilities` names the envelope). The project registry is read first,
  else the machine-level one; first found wins, never merged.

  Each entry names the env var holding its token ("secret_env"), a Notion
  integration token resolved through the standard cascade — a project
  .env(.local), then ~/.config/my-notion/credentials.env, then the process
  env. Never pass the token on the command line. "allow_write": false makes the
  connection read-only: every mutating verb (publish, create, upsert)
  exits 4, and no flag lifts the gate. Writes default to allowed (a
  workspace the consumer owns).

  Selection: --connection <id> (accepted anywhere on the command line).
  Unflagged, the registry's "default" pointer applies, else the sole entry;
  several entries without a pointer is refused as ambiguous.

Global option (accepted anywhere on the line):
  --token-env <KEY>   Act as a different identity by naming the env/cred KEY
                      that holds the token (default NOTION_TOKEN; with a
                      registry connection it overrides that entry's
                      secret_env). Names the key, never the value (e.g.
                      my-notion publish <page> --token-env NOTION_ALT_TOKEN).
                      It never lifts a connection's write gate.

Commands — pages:
  my-notion help                               Print this document.
  my-notion connections                        Where every connection's values
                                              resolve from. Local only.
  my-notion doctor [--connection <id>]         Health check — token + identity.
  my-notion whoami                             Identity + workspace.
  my-notion children <parent>                  List direct child pages.
  my-notion get <page>                         Fetch page as markdown (incl. title).
  my-notion publish <page> [<md>|-]            Replace body + title of a page.
  my-notion append <page> [<md>|-]             Add markdown to the END of a page in
                                              ONE request. Body preserved, title
                                              untouched. Use this instead of
                                              get + concatenate + publish.
  my-notion create --parent <p> [--title T] [<md>|-]
                                              Create new page under a parent.
  my-notion upsert --parent <p> [--title T] [<md>|-]
                                              Update by exact title or create.
  my-notion archive <ref> [--database]         Move a page (or database) to trash.
  my-notion restore <ref> [--database|--block] Take it back out of the trash
                                              (also a block deleted with
                                              `archive --block`): same id,
                                              children and comments. A page
                                              returns to its old parent; a
                                              BLOCK returns at the END of its
                                              page, not where it stood.
                                              Notion keeps the trash 30 days.
  my-notion search <text> [--type page|database] [--limit N]
                                              Find pages and databases by TITLE
                                              among those shared with the
                                              integration, newest edit first.
  my-notion page-meta <page> [--parent P] [--title T]
                                              Move a page (with its subpages)
                                              under another page (Notion's move
                                              endpoint), and/or rename it. Read
                                              back after the move; a
                                              page Notion did not move is
                                              reported, not called "moved".
  my-notion link <page> <target>               Put a link to <target> on <page>;
                                              it shows like a subpage while the
                                              target stays where it lives.

Commands — editing a page in place (blocks, ids and line comments survive):
  `publish` rebuilds every block, and a comment left on a line is lost with
  its block. To change part of a page that people have commented on, use:
  my-notion edit <page> --old <text> --new <md> [--old .. --new ..] [--all]
                                              Replace text. Each --old must
                                              match exactly once (--all: every
                                              match); otherwise Notion refuses
                                              and NOTHING changes. --new takes
                                              markdown (**bold**, links).
  my-notion insert <page> --after <text> [<md>|-]
                                              Insert markdown right after the
                                              line containing <text> (or a span
                                              'start...end'); it must match once.
  my-notion block-update <block> [<text>|-]    Rewrite one block's text by its
                                              id (from `blocks`), keeping its
                                              type and children. Inline
                                              markdown: **bold**, *italic*,
                                              ~~strike~~, `code`, [text](url).

Commands — databases (data-source model, Notion-Version 2026-03-11):
  my-notion db-create --parent <p> [--title T] [<props>|-]
                                              Create a database under a page.
                                              <props> = JSON Notion property schema,
                                              e.g. {"Name":{"title":{}},
                                              "Stage":{"select":{"options":[...]}}}.
                                              Returns database_id + data_source_id.
  my-notion db-schema <db>                     Show a database's property schema.
  my-notion db-meta <db> [--parent P] [--title T]
                                              Move the database under another
                                              page and/or rename it. ONE verb,
                                              because it is ONE call
                                              (PATCH /v1/databases/{id}) — and
                                              the move takes the ROWS with it,
                                              keeping created times, page
                                              history, comments and every column
                                              this CLI cannot write. Rebuilding
                                              the database under the new parent
                                              and copying rows loses all four.
                                              Needs Notion-Version 2026-03-11
                                              (2022-06-28 answers `400 parent
                                              must be a database`); this client
                                              pins it. A destination the token
                                              cannot see is refused by NAME
                                              before anything moves, instead of
                                              arriving as a 404 that reads like
                                              a bad database id. Refuses (exit 6)
                                              when neither flag is given.
  my-notion db-alter <db> [<props>|-] [--drop]  Add or change COLUMNS. Notion
                                              REPLACES a select's option list
                                              rather than merging it, so shrinking
                                              one blanks every row holding a value
                                              you left out — silently. This verb
                                              counts those rows first and REFUSES
                                              (exit 6) naming them; --drop accepts
                                              the loss deliberately. Options nobody
                                              holds are removed without asking.
                                              merges rather than replaces, so
                                              nothing is dropped here; removing a
                                              column means passing it null, which
                                              this verb deliberately never does
                                              on your behalf.
  my-notion db-add <db> [<props>|-]            Add a row; <props> = JSON property
                                              values keyed by column name. A
                                              people column takes EITHER a UUID
                                              or a display name / email, which is
                                              resolved for you (see `users`).
  my-notion db-query <db> [--filter J] [--sorts J] [--limit N]
                                              Query rows (returns flattened props).
                                              A row holding people also carries
                                              `people: {column: [{id, name}]}`
                                              beside `properties` — the ids the
                                              flattening drops, so a read can be
                                              written back with no second call.
                                              The flattened names stay exactly
                                              where they were.
  my-notion db-update <row> [<props>|-]        Update a row's property values.
                                              People resolve as in `db-add`.

Commands — users (a people column takes a UUID and nothing else):
  my-notion users list [--from <db>]           Who this token can name: id, name,
                                              type, and email where Notion
                                              exposes it. `GET /v1/users` is
                                              REFUSED to personal access tokens
                                              (403 "Personal access tokens cannot
                                              list users"), the same hole as
                                              /v1/search. When that happens the
                                              answer is assembled from the token
                                              itself, its owner, saved `user.`
                                              identifiers, and — with --from —
                                              whoever is assigned on that
                                              database's rows; it is labelled
                                              "source": "partial" and carries the
                                              refusal, because "no such user" and
                                              "I cannot see the users" must not
                                              read the same.
  my-notion users get <name|email|uuid> [--from <db>] [--save]
                                              Resolve one user to its id. A UUID
                                              round-trips (you learn the name).
                                              Matching is email-exact, then
                                              name-exact, then substring; more
                                              than one match is REFUSED (exit 7)
                                              naming the candidates rather than
                                              picking one. --save records the id
                                              in the project identifiers
                                              envelope, so the next agent
                                              resolves the same name without the
                                              directory.

Commands — views (a view is what makes a database readable):
  my-notion views <db>                         List the views on a database.
  my-notion view <view>                        Retrieve one view in full.
  my-notion view-create <db> --name N --type T [--page P]
        [--filter J] [--sorts J] [--config J] [--quick-filters J]
        [--group-by COLUMN]
                                              Create a view. Types: table,
                                              board, calendar, timeline,
                                              gallery, list, map, form, chart.
                                              WITHOUT --page the view is added
                                              as a tab on the database itself.
                                              WITH --page Notion creates a
                                              LINKED database block on that
                                              page and hangs the view off it —
                                              the source database is untouched,
                                              which is how one database shows
                                              as a filtered board on many
                                              pages. --config carries the
                                              type-specific block (board
                                              group_by, table properties, ...);
                                              its "type" is filled in from
                                              --type when omitted, and a
                                              mismatch is refused rather than
                                              sent. --group-by takes a column
                                              NAME and looks its property id
                                              up; a board without one is
                                              refused here rather than at
                                              Notion.
  my-notion view-update <view> [<json>|-]      Change name, filter, sorts or
                                              configuration of a view.
  my-notion view-delete <view>                 Delete a view.

Commands — comments, files:
  my-notion comments <page> [--blocks]        Read the page's comment threads
                                              (id, discussion_id, author, text).
                                              A thread on a line belongs to that
                                              block, not to the page, so a bare
                                              read misses it; --blocks walks the
                                              page's blocks (nested ones too, not
                                              child pages) and adds their threads
                                              with block_id and block_text. One
                                              request per block, so slower.
  my-notion comment <page> <text> [--discussion <id>] [--block <id>]
                                              Write a comment. Without
                                              --discussion it opens a new thread;
                                              with it the comment REPLIES into
                                              that thread — where the person who
                                              asked will actually look. --block
                                              anchors the new thread on that one
                                              block (a line, bullet or heading)
                                              instead of the whole page; take
                                              the id from `blocks`. Notion's API
                                              anchors to a whole block, never to
                                              a range of text inside it.
  my-notion comment-delete <comment>           Delete one comment; take its id
                                              from `comments`. Notion lets a
                                              token delete only the comments IT
                                              wrote: anyone else's answers 404,
                                              exactly like a wrong id, so a 404
                                              here can mean either. The other
                                              comments in its thread stay.
  my-notion comment-edit <comment> <text>      Replace the text of one comment;
                                              it keeps its id and thread. Only
                                              the token's OWN comments, as with
                                              delete (anyone else's answers 404).
  my-notion blocks <page|block>                List the direct child blocks: id,
                                              type, text, has_children. Pass a
                                              block id to walk into nested
                                              bullets. `comments <block-id>`
                                              reads the threads on one block,
                                              which `comments <page>` does not
                                              return.
  my-notion attach <page> <file|url> [--caption T] [--cover|--icon|--property COL]
                                              Put a file into the page body.
                                              Images/video/pdf get their own
                                              block type, so a screenshot is
                                              visible rather than a download link.
                                              A file over 20 MB goes up in parts
                                              by itself (paid plans only: a free
                                              workspace caps files at 5 MB). An http(s) URL is
                                              fetched by Notion, nothing is
                                              downloaded here. --cover / --icon
                                              set the page cover or icon instead;
                                              --property adds the file to that
                                              Files column of a database row,
                                              keeping the files already there.
  my-notion files <page>                       List attachments with FRESH urls.
                                              Notion signs them and they expire in
                                              about an hour — never store one.
  my-notion download <page> [<dir>]            Save attachments to a directory —
                                              how an agent actually reads them.
  my-notion archive <ref> --block              Delete one block, e.g. an
                                              attachment added by mistake.

  Comments need the integration to hold read/insert comment capabilities. Without
  them Notion answers 403 restricted_resource, and that is NOT "no comments": the
  refusal is raised, never flattened into an empty list, because a board that
  silently cannot see what was written on it is worse than one that errors.

  <db> takes a database UUID/URL (its primary data source resolves
  automatically). <props>/<filter>/<sorts> take a literal JSON string, a
  file path, or '-' for stdin.

Page references:
  <page> / <parent> accept a bare UUID (dashed or 32-char) OR a full Notion
  URL. The 32-hex slug is extracted from URLs automatically.

Markdown input:
  Any command that takes <md> accepts a file path, "-" for stdin, or no
  argument (defaults to stdin).

Title handling:
  The local markdown file is the source of truth for both the title and the
  body. If the first non-blank line is a level-1 heading (`# Title`), that
  line is extracted as the page title and stripped from the body before
  sending. This keeps local file and Notion page in sync via a single edit.

  - `get`: prepends `# <page title>` to the returned markdown.
  - `publish`: updates both the page body and (if the H1 changed) the title.
  - `create` / `upsert`: title comes from the H1 when present; `--title`
    is required only when the file has no leading H1. If both are given,
    the H1 wins.

Contract commands (the same on every capability):
  my-notion stub                               One-line awareness text.
  my-notion manifest --json                    Machine-readable declaration.
  my-notion guide [<topic>]                    Guide topics / one guide body.
  my-notion ids list|get <l>|set <l> <v>|rm <l>   Project identifiers envelope
              [--note <text>]                 (.capabilities/my-notion/identifiers.json).
  my-notion refs                               Menu of the project's reference files.
  my-notion inventory                          What it holds in this project; local only.

I/O contract:
  - Success: JSON on stdout, exit 0. (`get` emits raw markdown.)
  - Error:   {"error": {"code", "message", "hint", "status"}} on stderr,
             non-zero exit.

Exit codes:
  0  success
  2  auth (unauthorized / restricted_resource / missing credentials)
  3  not found (object_not_found)
  4  policy refusal — the project gate (.capabilities/settings.json) on any
     verb, or a write verb on a read-only connection (allow_write: false).
     Ask the user; never lift a gate yourself.
  5  server / network (5xx, timeout, rate-limit exhausted)
  6  input / validation
  7  conflict (domain-specific: ambiguous title in upsert, concurrent edit)

Quirks worth knowing:
  - `search` matches titles only, and only pages shared with the
    integration. Verified 2026-10-08 with an internal integration token; a
    personal access token was once seen to get zero results here, so an
    empty answer with such a token may be a refusal, not "no such page".
  - `GET /v1/users` is likewise refused to PAT tokens (403 restricted_resource,
    "Personal access tokens cannot list users"). `users list` says so rather
    than returning an empty directory; see the `users` block above.
  - `upsert` matches direct children only; a grandchild with the same
    title is not considered. Walk the tree explicitly if you need that.
"""

import argparse
import json
import os
import re
import sys
import time
from pathlib import Path
from typing import NoReturn

import httpx

API_BASE = "https://api.notion.com/v1"
NOTION_VERSION = "2026-03-11"
TIMEOUT = httpx.Timeout(30.0)
MAX_RETRIES = 3

# --- Capability declaration (protocol 2) — one home for every contract fact --

NAME = "my-notion"
SUMMARY = ("Notion CLI over the REST API — pages AND databases. Publish "
           "markdown, create/upsert pages; create databases, add/query/update "
           "rows (data-source model, 2026-03-11), and archive. Personal, multi-workspace.")
SCOPE = "project"   # credential scope: "project" | "user"
CRED_KEYS = [
    {"key": "NOTION_TOKEN", "secret": True, "required": True,
     "note": "integration token (default identity; alternates via --token-env)"},
]
WRITE_VERBS = {"publish", "append", "create", "upsert",
               "db-create", "db-add", "db-update", "archive",
               "comment", "comment-delete", "comment-edit", "attach",
               "edit", "insert", "block-update", "restore", "db-alter", "db-meta", "page-meta", "link",
               "view-create", "view-update", "view-delete"}   # domain verbs that mutate Notion
WRITE_DEFAULT = True    # writes stay inside a workspace the consumer owns
DOCS_BASE = ""      # upstream guides base URL; "" while no guides ship
TOPICS: list = []   # shipped guide topics
STATE = False       # True when the capability writes session/cache state
INVENTORY = None
POST_INSTALL: list = []
_STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))

_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
CONFIG_DIR = _CONFIG_HOME / NAME
CREDENTIALS_ENV = CONFIG_DIR / "credentials.env"

UUID_DASHED = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
UUID_PLAIN = re.compile(r"[0-9a-f]{32}")
H1_RE = re.compile(r"\A(?:[ \t]*\n)*[ \t]*#[ \t]+([^\n]+?)[ \t]*(?:\n|\Z)")


# The shared capability code is the capabilities-contract library's, bound here
# into this script's namespace (SHEBANG.md, "The contract verbs").
from capabilities_contract.capability import bind as _contract_bind

_contract_bind(globals(), "core")

_contract_bind(globals(), "store")


# --- Capability-specific project config --------------------------------------

def _project_settings() -> dict:
    """Capability-owned, non-secret project config: .capabilities/<NAME>/settings.json."""
    envdir = _env_dir()
    if envdir is None:
        return {}
    try:
        return json.loads((envdir / "settings.json").read_text())
    except (OSError, ValueError):
        return {}


# --- Credentials -------------------------------------------------------------

def _load_token(key: str = "NOTION_TOKEN") -> str:
    """Resolve a PAT by env-var NAME through the credential cascade — a project
    .env(.local), then ~/.config/my-notion/credentials.env, then the process env;
    first non-empty wins. `key` defaults to NOTION_TOKEN; the global
    `--token-env <KEY>` flag selects an alternate key to act as another identity.
    The token value never travels on the command line — only its name (so there is
    no value flag tier; the secret stays off argv, deliberately)."""
    tok = (_project_env().get(key)
           or _parse_env_file(CREDENTIALS_ENV).get(key)
           or os.environ.get(key)
           or "").strip()
    if tok:
        return tok
    if key == "NOTION_TOKEN":
        _die(2, "missing_token",
             f"NOTION_TOKEN not found in a project .env, {CREDENTIALS_ENV}, or the environment",
             "add NOTION_TOKEN=<your PAT> to the user config or a project .env")
    _die(2, "missing_token",
         f"{key} not found in a project .env, {CREDENTIALS_ENV}, or the environment",
         f"add {key}=<PAT> to the user config or a project .env to use --token-env {key}")


_contract_bind(globals(), "connections")


# --- Connections (capability-specific) ---------------------------------------

def _connections_report() -> dict:
    """The resolution report — every connection, every value, its winning tier
    and source, secrets masked. Local only: no network, no login attempt."""
    reg, _ = _connections_registry()
    report: dict = {"default": None, "connections": {}}
    if reg is None:
        value, tier, source = _resolve_env_key("NOTION_TOKEN")
        report["default"] = "default"
        report["connections"]["default"] = {
            "allow_write": WRITE_DEFAULT,
            "keys": [_key_report("NOTION_TOKEN", True, True, value, tier, source)]}
        return report
    conns = reg["connections"]
    report["default"] = reg.get("default") or \
        (next(iter(conns)) if len(conns) == 1 else None)
    for cid, entry in conns.items():
        entry = entry if isinstance(entry, dict) else {}
        secret_env = entry.get("secret_env")
        if secret_env:
            value, tier, source = _resolve_env_key(secret_env)
            keys = [_key_report(secret_env, True, True, value, tier, source)]
        else:
            keys = [_key_report("secret_env", False, True, None, None, None)]
        report["connections"][cid] = {
            "allow_write": bool(entry.get("allow_write", WRITE_DEFAULT)),
            "keys": keys}
    return report


def _cmd_connections() -> None:
    _emit(_connections_report())


# --- Reference parsing -------------------------------------------------------

def _to_uuid(ref: str) -> str:
    """Extract a canonical dashed UUID from a Notion URL or raw ID."""
    s = ref.strip().lower()
    m = UUID_DASHED.search(s)
    if m:
        return m.group(0)
    m = UUID_PLAIN.search(s.replace("-", ""))
    if m:
        h = m.group(0)
        return f"{h[0:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:32]}"
    _die(6, "bad_page_ref",
         f"could not extract a Notion page UUID from {ref!r}",
         "pass a 32-char hex UUID, a dashed UUID, or a full Notion page URL")


# --- Markdown input ----------------------------------------------------------

def _extract_h1_title(md: str) -> tuple[str | None, str]:
    """If the first non-blank line is `# Title`, return (title, body_without_h1).
    Otherwise return (None, md). Strips immediately following blank lines from
    the body so a round-trip with `_compose_with_h1` is idempotent.
    """
    m = H1_RE.match(md)
    if not m:
        return None, md
    title = m.group(1).strip()
    body = md[m.end():].lstrip("\n")
    return title, body


def _compose_with_h1(title: str, body: str) -> str:
    """Inverse of `_extract_h1_title`: prepend `# title` + blank line to body."""
    return f"# {title}\n\n{body}" if body else f"# {title}\n"


def _read_md(arg: str | None) -> str:
    if arg is None or arg == "-":
        data = sys.stdin.read()
        if not data:
            _die(6, "empty_stdin",
                 "no markdown content received on stdin",
                 "pipe content in, or pass a file path")
        return data
    # A path, or the markdown itself. Requiring a path made the common case —
    # appending one line — a two-step dance through a temporary file, and a
    # long argument crashed the path probe outright: Path.exists() raises
    # ENAMETOOLONG past 255 bytes per component on macOS and Python 3.12 does
    # not swallow that errno. Same defect as _read_json carried, fixed the same
    # way: anything that cannot be an existing file is content.
    try:
        p = Path(arg)
        if p.exists():
            return p.read_text(encoding="utf-8")
        looks_like_a_path = ("\n" not in arg and len(arg) < 256
                             and (arg.endswith(".md") or "/" in arg[:40]))
    except OSError:
        looks_like_a_path = False
    if looks_like_a_path:
        _die(6, "file_not_found",
             f"markdown file does not exist: {arg}",
             "check the path; pass the markdown itself, or '-' to read stdin")
    return arg


# --- HTTP --------------------------------------------------------------------

def _client(token: str) -> httpx.Client:
    return httpx.Client(
        base_url=API_BASE,
        timeout=TIMEOUT,
        headers={
            "Authorization": f"Bearer {token}",
            "Notion-Version": NOTION_VERSION,
            "Content-Type": "application/json",
        },
    )


def _request(client: httpx.Client, method: str, path: str,
             json_body: dict | None = None,
             not_found_hint: str | None = None,
             validation_hint: str | None = None) -> dict:
    last_status: int | None = None
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            resp = client.request(method, path, json=json_body)
        except httpx.TimeoutException:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5)
                continue
            _die(5, "timeout",
                 f"request timed out: {method} {path}",
                 "Notion API was unresponsive; check status.notion.com")
        except httpx.RequestError as e:
            _die(5, "network_error", f"network error: {e}", "check connectivity")

        last_status = resp.status_code
        if resp.status_code == 429:
            retry_after = float(resp.headers.get("Retry-After", "1"))
            if attempt < MAX_RETRIES:
                time.sleep(retry_after)
                continue
            _die(5, "rate_limited",
                 f"rate-limited after {MAX_RETRIES} attempts",
                 "back off and retry later", status=429)
        if resp.status_code >= 500:
            if attempt < MAX_RETRIES:
                time.sleep(attempt * 1.5)
                continue
            _die(5, "server_error",
                 f"Notion returned {resp.status_code}",
                 "check status.notion.com", status=resp.status_code)

        try:
            data = resp.json()
        except ValueError:
            _die(5, "invalid_response",
                 f"non-JSON response from {method} {path}",
                 status=resp.status_code)

        if resp.status_code >= 400:
            notion_code = data.get("code", "unknown_error")
            notion_msg = data.get("message", "")
            if notion_code in ("unauthorized", "restricted_resource"):
                exit_code = 2
                hint = "PAT may not have access to this resource"
            elif notion_code == "object_not_found":
                exit_code = 3
                hint = not_found_hint or \
                    "verify the page UUID and that the PAT can see it"
            elif notion_code == "validation_error":
                exit_code = 6
                hint = validation_hint or \
                    "check request body shape against Notion API docs"
            elif notion_code == "conflict_error":
                exit_code = 7
                hint = "the resource was modified concurrently; retry"
            else:
                exit_code = 5
                hint = None
            _die(exit_code, notion_code, notion_msg, hint, status=resp.status_code)

        return data

    _die(5, "exhausted_retries",
         f"exhausted {MAX_RETRIES} attempts on {method} {path}",
         status=last_status)


def _try_get(client: httpx.Client, path: str) -> tuple[int, dict]:
    """A GET whose 4xx is a fact rather than an exit.

    `_request` turns every Notion error into the right exit code, which is what
    almost every call wants. Two places want the status instead: listing users
    (a 403 is the ORDINARY answer for a personal access token, and there are
    other sources to try) and checking a move's destination (a 404 there means
    the parent, not the database, and saying so is the whole value).
    """
    try:
        resp = client.get(path)
    except httpx.TimeoutException:
        _die(5, "timeout", f"request timed out: GET {path}",
             "Notion API was unresponsive; check status.notion.com")
    except httpx.RequestError as e:
        _die(5, "network_error", f"network error: {e}", "check connectivity")
    try:
        return resp.status_code, resp.json()
    except ValueError:
        return resp.status_code, {}


# --- Helpers -----------------------------------------------------------------

def _page_title(page: dict) -> str:
    props = page.get("properties", {}) or {}
    for v in props.values():
        if v.get("type") == "title":
            arr = v.get("title") or []
            if arr:
                return "".join(t.get("plain_text", "") for t in arr)
    return ""


def _title_prop_key(page: dict) -> str | None:
    """Find the property key whose type is `title` (usually 'title' for normal
    pages; can differ for database rows)."""
    props = page.get("properties", {}) or {}
    for k, v in props.items():
        if v.get("type") == "title":
            return k
    return None


def _title_property_body(prop_key: str, title: str) -> dict:
    return {
        "properties": {
            prop_key: {"title": [{"type": "text", "text": {"content": title}}]}
        }
    }


def _page_summary(page: dict, action: str | None = None) -> dict:
    out = {
        "page_id": page.get("id"),
        "url": page.get("url"),
        "title": _page_title(page),
    }
    if action:
        out["action"] = action
    return out


# --- Commands ----------------------------------------------------------------

def _check_connection(token: str) -> dict:
    """One connection's round-trip, reported rather than died — doctor covers
    every connection, so a broken one becomes a finding, not a stop."""
    try:
        with _client(token) as c:
            r = c.get("/users/me")
            if r.status_code >= 400:
                cat = 2 if r.status_code in (401, 403) else 5
                return {"ok": False, "category": cat,
                        "error": f"/users/me returned {r.status_code}"}
            data = r.json()
            bot = data.get("bot", {}) or {}
            return {"ok": True, "name": data.get("name"),
                    "workspace_name": bot.get("workspace_name")}
    except httpx.RequestError as e:
        return {"ok": False, "category": 5, "error": f"network error: {e}"}
    except (ValueError, KeyError) as e:
        return {"ok": False, "category": 5, "error": f"bad response: {e}"}


def cmd_doctor(reg: dict | None, wanted: str | None,
               token_key_override: str | None) -> None:
    """Every connection bare; one with --connection. Exit 0 only when every
    examined connection is healthy, else the first failure's category."""
    _doctor_gate(_connections_report(), wanted)
    if wanted is not None or reg is None:
        targets = [_select_connection(reg, wanted)]
    else:
        targets = list(reg["connections"].items())
    connections: dict = {}
    fail_exit = 0
    for cid, entry in targets:
        key = token_key_override or \
            ("NOTION_TOKEN" if entry is None else entry.get("secret_env"))
        if not key:
            res = {"ok": False, "category": 6,
                   "error": f"connection {cid!r} is missing 'secret_env'"}
        else:
            token = _resolve_env_key(key)[0]
            if not token:
                res = {"ok": False, "category": 2,
                       "error": f"{key} not found in a project .env, "
                                f"{CREDENTIALS_ENV}, or the environment"}
            else:
                res = _check_connection(token)
        if not res.get("ok") and not fail_exit:
            fail_exit = res.get("category") or 5
        res.pop("category", None)
        connections[cid] = res
    _emit({"ok": fail_exit == 0, "connections": connections})
    if fail_exit:
        sys.exit(fail_exit)


def cmd_whoami(c: httpx.Client) -> dict:
    data = _request(c, "GET", "/users/me")
    bot = data.get("bot", {}) or {}
    owner = bot.get("owner", {}) or {}
    out = {
        "id": data.get("id"),
        "name": data.get("name"),
        "type": data.get("type"),
        "owner_type": owner.get("type"),
        "workspace_name": bot.get("workspace_name"),
    }
    if owner.get("type") == "user":
        out["owner_user"] = (owner.get("user") or {}).get("name")
    return out


def cmd_children(c: httpx.Client, parent: str) -> list[dict]:
    parent_id = _to_uuid(parent)
    results: list[dict] = []
    cursor: str | None = None
    while True:
        path = f"/blocks/{parent_id}/children?page_size=100"
        if cursor:
            path += f"&start_cursor={cursor}"
        data = _request(c, "GET", path)
        for r in data.get("results", []):
            if r.get("type") == "child_page":
                results.append({
                    "id": r["id"],
                    "title": (r.get("child_page") or {}).get("title", ""),
                })
        if not data.get("has_more"):
            break
        cursor = data.get("next_cursor")
    return results


def cmd_get(c: httpx.Client, page: str) -> str:
    page_id = _to_uuid(page)
    page_data = _request(c, "GET", f"/pages/{page_id}")
    title = _page_title(page_data)
    data = _request(c, "GET", f"/pages/{page_id}/markdown")
    md = data.get("markdown", "")
    return _compose_with_h1(title, md) if title else md


def cmd_append(c: httpx.Client, page: str, md: str) -> dict:
    """Add markdown to the END of a page, in ONE request.

    `publish` replaces a page wholesale, so adding a paragraph meant read, join,
    write-all: three round trips, a race with anyone else editing, and a body
    lost outright when the write failed halfway. Notion has had the primitive all
    along — `insert_content` on the markdown endpoint — and this capability
    simply never exposed it. Verified against the live API 2026-09-03: the
    endpoint accepts `insert_content`, `replace_content`, `replace_content_range`
    and `update_content`, and names the three it did not get.

    The title is left alone: appending is not renaming, so a leading H1 becomes
    a heading in the page rather than a new page title.
    """
    page_id = _to_uuid(page)
    data = _request(c, "PATCH", f"/pages/{page_id}/markdown",
                    {"type": "insert_content", "insert_content": {"content": md}})
    if data.get("object") != "page":
        data = _request(c, "GET", f"/pages/{page_id}")
    return _page_summary(data, action="appended")


def cmd_publish(c: httpx.Client, page: str, md: str) -> dict:
    page_id = _to_uuid(page)
    h1_title, body_md = _extract_h1_title(md)

    body_patch = {"type": "replace_content",
                  "replace_content": {"new_str": body_md}}
    data = _request(c, "PATCH", f"/pages/{page_id}/markdown", body_patch)
    if data.get("object") != "page":
        data = _request(c, "GET", f"/pages/{page_id}")

    if h1_title is not None and h1_title != _page_title(data):
        prop_key = _title_prop_key(data)
        if prop_key is None:
            _die(5, "no_title_property",
                 "page has no property of type 'title'",
                 "this should not happen for normal pages; check the page id")
        data = _request(c, "PATCH", f"/pages/{page_id}",
                        _title_property_body(prop_key, h1_title))
    return _page_summary(data, action="updated")


# --- edits in place -----------------------------------------------------------
#
# `publish` rebuilds every block, and a comment left on a line goes with the
# block it sits on. On 2026-10-08 that nearly cost eleven line comments on a
# shared terms page. The three verbs below change a page and keep every other
# block, its id and its threads. Verified live 2026-10-08: `update_content`
# rewrites a line in place (same block id, comments still on it), and
# `insert_content` with `after` adds blocks without touching their neighbours.

def cmd_edit(c: httpx.Client, page: str, pairs: list[tuple[str, str]],
             replace_all: bool) -> dict:
    """Replace text on a page, keeping the blocks it sits in and their comments.

    Each old text must match exactly once unless `replace_all`; Notion refuses
    an ambiguous or missing match and changes nothing, and its message (which
    quotes the page) is passed through so the caller sees why.
    """
    page_id = _to_uuid(page)
    updates = [{"old_str": o, "new_str": n,
                **({"replace_all_matches": True} if replace_all else {})}
               for o, n in pairs]
    data = _request(c, "PATCH", f"/pages/{page_id}/markdown",
                    {"type": "update_content",
                     "update_content": {"content_updates": updates}})
    return {"object": "page", "page_id": page_id, "replaced": len(updates),
            "markdown": data.get("markdown"), "action": "edited"}


def cmd_insert(c: httpx.Client, page: str, after: str, md: str) -> dict:
    """Insert markdown after the line holding `after`, nothing else moves.

    `after` is the text of that line, or `start...end` for a span; it must
    match once. The new blocks get new ids; every existing block keeps its own.
    """
    page_id = _to_uuid(page)
    data = _request(c, "PATCH", f"/pages/{page_id}/markdown",
                    {"type": "insert_content",
                     "insert_content": {"content": md, "after": after}})
    return {"object": "page", "page_id": page_id,
            "markdown": data.get("markdown"), "action": "inserted"}


_INLINE = re.compile(r"(\*\*.+?\*\*|~~.+?~~|`[^`]+`|\[[^\]]+\]\([^)\s]+\)"
                     r"|(?<![*\w])\*[^*\s][^*]*?\*(?!\*)|(?<!\w)_[^_\s][^_]*?_(?!\w))")


def _rich_text(md: str) -> list:
    """Inline markdown (bold, italic, strike, code, links) as Notion rich text."""
    out: list = []

    def seg(text: str, url: str | None = None, **ann) -> None:
        for i in range(0, len(text), 1900):
            t: dict = {"type": "text", "text": {"content": text[i:i + 1900]}}
            if url:
                t["text"]["link"] = {"url": url}
            if ann:
                t["annotations"] = ann
            out.append(t)

    for part in _INLINE.split(md):
        if not part:
            continue
        if part.startswith("**") and part.endswith("**") and len(part) > 4:
            seg(part[2:-2], bold=True)
        elif part.startswith("~~") and part.endswith("~~") and len(part) > 4:
            seg(part[2:-2], strikethrough=True)
        elif part.startswith("`") and part.endswith("`") and len(part) > 2:
            seg(part[1:-1], code=True)
        elif m := re.fullmatch(r"\[([^\]]+)\]\(([^)\s]+)\)", part):
            seg(m.group(1), url=m.group(2))
        elif len(part) > 2 and part[0] == part[-1] and part[0] in "*_":
            seg(part[1:-1], italic=True)
        else:
            seg(part)
    return out


def cmd_block_update(c: httpx.Client, block: str, text: str) -> dict:
    """Rewrite one block's text by its id; the block, its children and its
    comments stay. Its type stays too: a bullet remains a bullet."""
    block_id = _to_uuid(block)
    b = _request(c, "GET", f"/blocks/{block_id}")
    btype = b.get("type")
    if "rich_text" not in (b.get(btype) or {}):
        _die(6, "no_text", f"a {btype} block has no text to rewrite",
             "take a text block's id from `blocks` (paragraph, heading, "
             "bullet, to-do, quote, callout, toggle)")
    _request(c, "PATCH", f"/blocks/{block_id}",
             {btype: {"rich_text": _rich_text(text.rstrip("\n"))}})
    return {"object": "block", "id": block_id, "type": btype,
            "action": "updated"}


def cmd_search(c: httpx.Client, query: str, kind: str | None,
               limit: int) -> dict:
    """Pages and databases whose title matches, among those the token can see.

    Verified 2026-10-08 with an internal integration token: `POST /v1/search`
    answers. Notion matches titles, not body text, and sees only what has been
    shared with the integration.
    """
    body: dict = {"query": query, "page_size": min(limit or 100, 100),
                  "sort": {"direction": "descending",
                           "timestamp": "last_edited_time"}}
    if kind:
        body["filter"] = {"property": "object",
                          "value": "data_source" if kind == "database" else kind}
    out, cursor = [], None
    while True:
        if cursor:
            body["start_cursor"] = cursor
        data = _request(c, "POST", "/search", body)
        for r in data.get("results", []):
            if r.get("object") == "page":
                title = _page_title(r)
            else:
                title = "".join(t.get("plain_text", "")
                                for t in r.get("title", []) or [])
            parent = r.get("parent") or {}
            hit = {"object": r.get("object"), "id": r.get("id"),
                   "title": title, "url": r.get("url"),
                   "parent": {k: v for k, v in parent.items() if k != "type"},
                   "last_edited_time": r.get("last_edited_time")}
            if r.get("object") == "data_source":
                # Every <db> argument here takes the DATABASE id; Notion's
                # search answers with the data source, whose parent it is.
                hit = {**hit, "object": "database",
                       "id": parent.get("database_id"),
                       "data_source_id": r.get("id"), "parent": None}
            out.append(hit)
        if (limit and len(out) >= limit) or not data.get("has_more"):
            break
        cursor = data.get("next_cursor")
    if limit:
        out = out[:limit]
    return {"query": query, "count": len(out), "results": out}


def _resolve_title(h1_title: str | None, title_arg: str | None) -> str:
    """H1 wins; fall back to --title; otherwise abort."""
    if h1_title:
        return h1_title
    if title_arg:
        return title_arg
    _die(6, "missing_title",
         "no title: file has no leading '# H1' and --title not given",
         "add a '# Title' as the first line of the file, or pass --title")


def cmd_create(c: httpx.Client, parent: str,
               title_arg: str | None, md: str) -> dict:
    parent_id = _to_uuid(parent)
    h1_title, body_md = _extract_h1_title(md)
    title = _resolve_title(h1_title, title_arg)
    body = {
        "parent": {"page_id": parent_id},
        "properties": {
            "title": {"title": [{"type": "text", "text": {"content": title}}]}
        },
        "markdown": body_md,
    }
    data = _request(c, "POST", "/pages", body)
    return _page_summary(data, action="created")


def cmd_upsert(c: httpx.Client, parent: str,
               title_arg: str | None, md: str) -> dict:
    parent_id = _to_uuid(parent)
    h1_title, _ = _extract_h1_title(md)
    title = _resolve_title(h1_title, title_arg)
    children = cmd_children(c, parent_id)
    matches = [ch for ch in children if ch["title"] == title]
    if len(matches) > 1:
        _die(7, "ambiguous_title",
             f"{len(matches)} direct children of parent match title {title!r}",
             "use 'publish <id>' against a specific page to disambiguate")
    if len(matches) == 1:
        return cmd_publish(c, matches[0]["id"], md)
    return cmd_create(c, parent_id, title, md)


# --- Users (what makes a people column writable) -----------------------------
#
# A people column is the only way a board hands a row to a human and has Notion
# notify them, and Notion accepts nothing there but a UUID. `db-query` reads
# those columns back as display names, so until this existed a row copied out
# of one board could not be written into another: the names went in and the API
# answered `people[0].id should be a valid uuid`. Six rows were migrated that
# way on 2026-09-05 and every people value was dropped silently.
#
# `GET /v1/users` is refused to personal access tokens — 403 restricted_resource,
# "Personal access tokens cannot list users" — the same class of hole as
# `POST /v1/search`. So the directory is assembled from every source the token
# CAN see and it says which answered. A partial directory is labelled partial
# rather than passed off as the workspace: "no such user" and "I cannot see the
# users" are different answers, and flattening them is how an agent concludes a
# colleague does not exist.

_USER_LABEL = "user."          # identifiers-envelope prefix for a saved user id
_LABEL_SAFE = re.compile(r"[^a-z0-9._@+-]+")


def _user_label(name: str, uid: str) -> str:
    """A KEY_RE-legal identifiers label for one user (spaces are not legal)."""
    slug = _LABEL_SAFE.sub("-", (name or "").lower()).strip("-")
    return _USER_LABEL + (slug or uid)


def _looks_like_uuid(s: str) -> bool:
    t = s.strip().lower()
    return bool(UUID_DASHED.fullmatch(t) or UUID_PLAIN.fullmatch(t.replace("-", "")))


def _user_brief(u: dict) -> dict:
    """id, name, type — plus the email only where Notion actually exposes it
    (a bot has none, and a person's is absent unless the token may read it)."""
    out = {"id": u.get("id"), "name": u.get("name"), "type": u.get("type")}
    email = (u.get("person") or {}).get("email")
    if email:
        out["email"] = email
    return out


def _users_from_api(c: httpx.Client) -> tuple[list[dict], str | None]:
    """The whole workspace directory, or the refusal that stopped it.

    A 403 is returned rather than raised: it is the ordinary answer for a
    personal access token, and the caller has other sources to try.
    """
    users: list[dict] = []
    cursor: str | None = None
    while True:
        path = "/users?page_size=100" + (f"&start_cursor={cursor}" if cursor else "")
        status, data = _try_get(c, path)
        if status == 403:
            return [], data.get("message") or "this token may not list users"
        if status >= 400:
            _die(2 if status == 401 else 5,
                 data.get("code", "users_unavailable"),
                 data.get("message", f"GET /users returned {status}"),
                 status=status)
        users.extend(data.get("results") or [])
        if not data.get("has_more"):
            return users, None
        cursor = data.get("next_cursor")


def _users_directory(c: httpx.Client, from_db: str | None = None) -> dict:
    """Every user this token can name, and how completely.

    Sources, merged in this order so the authoritative one wins and the later
    ones only fill gaps: the workspace directory; the token's own identity and
    its owner; `user.` labels saved in the project identifiers envelope; and,
    with --from, whoever is already assigned on that database's rows — which is
    exactly the set a migration between two boards needs.
    """
    api, restricted = _users_from_api(c)
    found: dict[str, dict] = {}

    def note(u: dict) -> None:
        uid = u.get("id")
        if not uid:
            return
        brief = _user_brief(u)
        if uid in found:
            found[uid].update({k: v for k, v in brief.items() if v})
        else:
            found[uid] = brief

    for u in api:
        note(u)

    if restricted:
        me = _request(c, "GET", "/users/me")
        note(me)
        owner = ((me.get("bot") or {}).get("owner") or {}).get("user")
        if isinstance(owner, dict):
            note(owner)
        for label, entry in _identifiers_load().items():
            if not label.startswith(_USER_LABEL):
                continue
            value = (entry or {}).get("value")
            if not isinstance(value, str) or not _looks_like_uuid(value):
                continue
            status, data = _try_get(c, f"/users/{_to_uuid(value)}")
            if status == 200:
                note(data)

    if from_db:
        ds_id = _data_source_id(c, from_db)
        for row in _all_rows(c, ds_id):
            for v in (row.get("properties") or {}).values():
                if v.get("type") == "people":
                    for u in (v.get("people") or []):
                        note(u)

    users = sorted(found.values(), key=lambda u: (u.get("name") or "").lower())
    out: dict = {"source": "partial" if restricted else "workspace",
                 "count": len(users), "users": users}
    if restricted:
        out["restricted"] = restricted
        out["hint"] = (
            "this token may not list the workspace directory, so this is only "
            "who it has already met: itself, its owner, saved `user.` "
            "identifiers, and — with --from <db> — whoever is assigned on that "
            "database's rows. Someone missing here is not someone missing from "
            "the workspace. Save an id once with `users get <q> --save` and it "
            "stays findable.")
    return out


def _match_users(users: list[dict], query: str) -> list[dict]:
    """Email exact, then name exact, then substring — narrowest tier that hits
    anything wins, so a person whose name contains another's still resolves."""
    q = query.strip().lower()
    for tier in (lambda u: (u.get("email") or "").lower() == q,
                 lambda u: (u.get("name") or "").lower() == q):
        hits = [u for u in users if tier(u)]
        if hits:
            return hits
    return [u for u in users
            if q in (u.get("name") or "").lower()
            or q in (u.get("email") or "").lower()]


def _resolve_user(c: httpx.Client, query: str,
                  from_db: str | None = None) -> dict:
    """One display name, email or UUID to one user record.

    A UUID is already an answer and is only round-tripped so the caller learns
    the name behind it. Everything else goes through the directory, and the
    --from scan is deliberately the LAST resort: it walks every row of a
    database, which is not a price to pay when the cheap sources already know
    the answer.
    """
    if _looks_like_uuid(query):
        return _user_brief(_request(c, "GET", f"/users/{_to_uuid(query)}"))

    report = _users_directory(c)
    hits = _match_users(report["users"], query)
    if not hits and from_db:
        report = _users_directory(c, from_db)
        hits = _match_users(report["users"], query)

    if len(hits) > 1:
        _die(7, "ambiguous_user",
             f"{query!r} matches {len(hits)} users: "
             + ", ".join(f"{u.get('name')!r} ({u.get('id')})" for u in hits),
             "pass the full name, the email, or the UUID — nothing was written")
    if not hits:
        _die(3, "user_not_found",
             f"no user matching {query!r}"
             + (f" — {report['restricted']}" if report.get("restricted") else ""),
             "run `my-notion users list"
             + ("" if from_db else " --from <db>")
             + "` to see who this token can name, or pass the UUID directly")
    return hits[0]


def _people_ids(c: httpx.Client, value,
                from_db: str | None = None) -> list[dict]:
    """A people property value out of whatever the caller had.

    UUIDs pass through untouched and dicts are assumed to be Notion's own shape;
    a bare string is resolved. That is the whole point: a row read by `db-query`
    carries display names, and this is what lets it be written straight back.
    """
    if value is None:
        return []
    vals = value if isinstance(value, list) else [value]
    out: list[dict] = []
    for v in vals:
        if v is None:
            continue
        if isinstance(v, dict):
            out.append(v)
            continue
        s = str(v)
        uid = _to_uuid(s) if _looks_like_uuid(s) else _resolve_user(c, s, from_db)["id"]
        out.append({"object": "user", "id": uid})
    return out


def _people_of(props: dict) -> dict:
    """People columns as {column: [{id, name}]}.

    It rides ALONGSIDE the names `_flatten_props` produces rather than replacing
    them — callers already parse that shape — and it is what turns a read into a
    read-modify-write without a second call.
    """
    out: dict = {}
    for k, v in props.items():
        if v.get("type") != "people":
            continue
        out[k] = [{"id": u.get("id"), "name": u.get("name")}
                  for u in (v.get("people") or [])]
    return out


def cmd_users(c: httpx.Client, action: str, query: str | None,
              from_db: str | None, save: bool) -> dict:
    if action == "list":
        return _users_directory(c, from_db)
    if not query:
        _die(6, "input", "usage: my-notion users get <name|email|uuid>")
    user = _resolve_user(c, query, from_db)
    if save:
        label = _user_label(user.get("name") or "", user["id"])
        _identifiers_write(label, user["id"],
                           f"Notion user id — {user.get('name')} ({user.get('type')})")
        user = {**user, "saved_as": label}
    return user


# --- Databases (data-source model, Notion-Version 2026-03-11) ----------------

def _read_json(arg: str | None) -> dict:
    """Read a JSON object from a literal string, a file path, or stdin ('-')."""
    if arg is None or arg == "-":
        raw = sys.stdin.read()
        if not raw.strip():
            _die(6, "empty_stdin", "no JSON received on stdin",
                 "pipe a JSON object in, pass a file path, or a literal JSON string")
    else:
        # A JSON literal is a literal. Deciding that by asking the filesystem
        # first is what broke here: Path.exists() raises ENAMETOOLONG (macOS,
        # 255 bytes per component) on any properties blob longer than a short
        # row, and Python 3.12 does not swallow that errno — so passing a real
        # row inline crashed with a traceback instead of being parsed.
        raw = arg
        if not arg.lstrip().startswith(("{", "[")):
            try:
                p = Path(arg)
                if p.exists():
                    raw = p.read_text(encoding="utf-8")
            except OSError:
                pass
    try:
        val = json.loads(raw)
    except ValueError as e:
        _die(6, "bad_json", f"could not parse JSON: {e}",
             "pass a valid JSON object (literal string, file path, or '-')")
    if not isinstance(val, dict):
        _die(6, "bad_json", "expected a JSON object", "wrap the value in { ... }")
    return val


def _flatten_props(props: dict) -> dict:
    """Reduce Notion property values to readable scalars for query output."""
    out: dict = {}
    for k, v in props.items():
        t = v.get("type")
        val = v.get(t)
        if t in ("title", "rich_text"):
            out[k] = "".join(x.get("plain_text", "") for x in (val or []))
        elif t in ("select", "status"):
            out[k] = (val or {}).get("name")
        elif t == "multi_select":
            out[k] = [o.get("name") for o in (val or [])]
        elif t == "date":
            out[k] = (val or {}).get("start") if val else None
        elif t == "people":
            out[k] = [pp.get("name") or pp.get("id") for pp in (val or [])]
        elif t == "relation":
            out[k] = [rel.get("id") for rel in (val or [])]
        elif t in ("number", "checkbox", "url", "email", "phone_number"):
            out[k] = val
        elif t == "unique_id":
            # `{"prefix": "TASK", "number": 17}` -> `TASK-17`. Without this branch
            # the auto-number arrived as the WORD "unique_id": the same string on
            # every row of a board, which reads as "all the numbers matched"
            # rather than "the number was not read". On 2026-09-01 Notion's
            # auto-number was declared unusable on that ground; the verdict held
            # for other reasons, but this argument was our own bug.
            num = (val or {}).get("number")
            pref = (val or {}).get("prefix")
            out[k] = None if num is None else (f"{pref}-{num}" if pref else str(num))
        elif t == "formula":
            # A formula carries its type inside: `{"type": "number", "number": 3}`.
            inner = (val or {}).get("type")
            out[k] = (val or {}).get(inner) if inner else None
        elif t == "rollup":
            inner = (val or {}).get("type")
            out[k] = (val or {}).get(inner) if inner else None
        elif t == "files":
            out[k] = [f.get("name") for f in (val or [])]
        else:
            out[k] = val if isinstance(val, (str, int, float, bool, type(None))) else t
    return out


def _data_source_id(c: httpx.Client, db_ref: str) -> str:
    """Resolve a database UUID/URL to its primary data_source id."""
    db_id = _to_uuid(db_ref)
    db = _request(c, "GET", f"/databases/{db_id}")
    sources = db.get("data_sources") or []
    if not sources:
        _die(5, "no_data_source", f"database {db_id} exposes no data source",
             "the database may be malformed; open it in Notion to check")
    return sources[0]["id"]


def cmd_db_create(c: httpx.Client, parent: str, title_arg: str | None,
                  props: dict) -> dict:
    parent_id = _to_uuid(parent)
    title = title_arg or "Untitled database"
    body = {
        "parent": {"type": "page_id", "page_id": parent_id},
        "title": [{"type": "text", "text": {"content": title}}],
        "initial_data_source": {"properties": props},
    }
    db = _request(c, "POST", "/databases", body)
    sources = db.get("data_sources") or [{}]
    return {
        "object": "database",
        "database_id": db.get("id"),
        "data_source_id": sources[0].get("id"),
        "title": title,
        "url": db.get("url"),
        "action": "created",
    }


def cmd_db_meta(c: httpx.Client, db: str, parent: str | None,
                title: str | None) -> dict:
    """Move a database under another page, and/or rename it.

    ONE verb rather than `db-move` + `db-rename`, because it is one call on
    `PATCH /v1/databases/{id}` and this CLI names verbs after the endpoint they
    stand for — `db-alter` for the columns, `db-update` for a row's values,
    `view-update` for a view. Two names for one call would be the only place
    that stopped being true, and the same PATCH still has icon, cover and
    description to grow into.

    The move carries the ROWS with it. Rebuilding the database under the new
    parent and copying rows across — the only thing possible before this — loses
    created timestamps, page history, comments, and every column the CLI cannot
    write. That is what happened on 2026-09-05.

    The move needs the current API version: on `2022-06-28` Notion answers
    `400 parent must be a database`; on the `2026-03-11` this client pins, 200.
    """
    if parent is None and title is None:
        _die(6, "nothing_to_change",
             "db-meta changes a database's parent or its title, and neither "
             "was given",
             "pass --parent <page> and/or --title <text>")
    db_id = _to_uuid(db)
    body: dict = {}
    if parent is not None:
        parent_id = _to_uuid(parent)
        # A destination the token cannot see comes back from the PATCH as a
        # bare 404, which reads like a wrong DATABASE id and sends the caller
        # looking in the wrong place. So it is named here, before anything
        # moves.
        status, data = _try_get(c, f"/pages/{parent_id}")
        if status == 404:
            _die(3, "parent_not_found",
                 f"the destination page {parent_id} is not visible to this token",
                 "share that page with the integration, or check the id — the "
                 "database was NOT moved")
        if status >= 400:
            _die(2 if status in (401, 403) else 5,
                 data.get("code", "parent_unreachable"),
                 data.get("message", f"GET /pages/{parent_id} returned {status}"),
                 "the database was NOT moved", status=status)
        body["parent"] = {"type": "page_id", "page_id": parent_id}
    if title is not None:
        body["title"] = [{"type": "text", "text": {"content": title}}]
    data = _request(c, "PATCH", f"/databases/{db_id}", body)
    return {
        "object": "database",
        "database_id": data.get("id"),
        "title": "".join(t.get("plain_text", "") for t in (data.get("title") or [])),
        "parent": data.get("parent"),
        "url": data.get("url"),
        "action": "+".join(a for a in (("moved" if parent is not None else None),
                                       ("renamed" if title is not None else None))
                           if a),
    }


def cmd_link(c: httpx.Client, parent: str, target: str) -> dict:
    """Put a native link-to-page block on a page, pointing at another page.

    The answer to a page that should appear in two places, or that the move
    endpoint does not move: some pages predate us and belong where they are.

    A `link_to_page` block renders exactly like a child page in the parent's
    body, so the page appears where it is wanted while continuing to live where
    it lives. Nothing is duplicated and no existing link breaks.
    """
    parent_id = _to_uuid(parent)
    target_id = _to_uuid(target)
    status, data = _try_get(c, f"/pages/{target_id}")
    if status >= 400:
        _die(3 if status == 404 else 5,
             data.get("code", "target_unreachable"),
             data.get("message", f"GET /pages/{target_id} returned {status}"),
             "nothing was added", status=status)
    body = {"children": [{"object": "block", "type": "link_to_page",
                          "link_to_page": {"type": "page_id",
                                           "page_id": target_id}}]}
    out = _request(c, "PATCH", f"/blocks/{parent_id}/children", body)
    made = (out.get("results") or [{}])[0]
    return {"object": "block", "block_id": made.get("id"),
            "parent_page": parent_id, "links_to": target_id,
            "action": "linked"}


def cmd_page_meta(c: httpx.Client, page: str, parent: str | None,
                  title: str | None) -> dict:
    """Move a page under another page, and/or rename it.

    The sibling of `db-meta`, for the other object type. It existed as a gap
    rather than a decision — a database could be reparented from the CLI and a
    page could not, so moving a project page under HQ meant doing it by hand.

    The move goes through `POST /v1/pages/{id}/move`; the rename through
    `PATCH /v1/pages/{id}`. Measured 2026-10-27: `PATCH` with a `parent` answers
    200 and leaves the parent unchanged on every page, even one the integration
    had just created directly under a page, so it never moves anything.

    A page carries its children with it, so this moves a whole subtree. That is
    also why the destination is checked first: a 404 from the PATCH itself
    reads like a wrong PAGE id and sends the caller looking in the wrong place.

    Renaming needs the page's own title property name, which is not always
    "title" on a database row. This verb renames only pages whose parent is a
    page or the workspace; for a database row use `db-update`, which knows the
    schema.
    """
    if parent is None and title is None:
        _die(6, "nothing_to_change",
             "page-meta changes a page's parent or its title, and neither was given",
             "pass --parent <page> and/or --title <text>")
    page_id = _to_uuid(page)
    body: dict = {}
    if parent is not None:
        parent_id = _to_uuid(parent)
        status, data = _try_get(c, f"/pages/{parent_id}")
        if status == 404:
            _die(3, "parent_not_found",
                 f"the destination page {parent_id} is not visible to this token",
                 "share that page with the integration, or check the id — the "
                 "page was NOT moved")
        if status >= 400:
            _die(2 if status in (401, 403) else 5,
                 data.get("code", "parent_unreachable"),
                 data.get("message", f"GET /pages/{parent_id} returned {status}"),
                 "the page was NOT moved", status=status)
    if title is not None:
        status, current = _try_get(c, f"/pages/{page_id}")
        if status >= 400:
            _die(3 if status == 404 else 5,
                 current.get("code", "page_unreachable"),
                 current.get("message", f"GET /pages/{page_id} returned {status}"),
                 "nothing was changed", status=status)
        props = current.get("properties") or {}
        title_key = next((k for k, v in props.items()
                          if isinstance(v, dict) and v.get("type") == "title"), None)
        if title_key is None:
            _die(6, "no_title_property",
                 "this page has no title property to rename",
                 "for a database row use db-update, which knows the schema")
        body["properties"] = {title_key: {"title": [{"type": "text",
                                                     "text": {"content": title}}]}}
    if parent is not None:
        _request(c, "POST", f"/pages/{page_id}/move",
                 {"parent": {"type": "page_id", "page_id": parent_id}})
    if body:
        _request(c, "PATCH", f"/pages/{page_id}", body)

    # Read the page back and judge the MOVE on what the page says afterwards,
    # never on the write's own echo. Measured 2026-09-06: a page living inside a
    # block rather than directly under a page took the PATCH with 200 and the
    # parent unchanged, so the first version of this verb reported "moved" about
    # a page that had not moved. A write verb that reports success from the
    # response it just sent is not a check.
    _, data = _try_get(c, f"/pages/{page_id}")
    now_parent = data.get("parent") or {}
    out = {
        "object": "page",
        "page_id": data.get("id"),
        "parent": now_parent,
        "url": data.get("url"),
    }
    actions = []
    if parent is not None:
        landed = now_parent.get("page_id") or now_parent.get("block_id")
        if _to_uuid(str(landed)) == parent_id:
            actions.append("moved")
        else:
            _die(5, "move_did_not_take",
                 f"Notion accepted the request and the page is still under "
                 f"{now_parent.get('type')} {landed}, not under {parent_id}",
                 "check that the integration can edit both the page and the "
                 "destination; if it can, move it in the app, or use "
                 "`my-notion link` to show it there without moving it",
                 status=200)
    if title is not None:
        actions.append("renamed")
    out["action"] = "+".join(actions)
    return out


def _shape_value(kind: str, value):
    """One property value in the shape Notion wants, from a plain scalar."""
    if value is None:
        return {"title": [], "rich_text": [], "multi_select": [], "people": [],
                "relation": [], "select": None, "status": None, "date": None}.get(kind)
    if kind in ("title", "rich_text"):
        return [{"text": {"content": str(value)}}]
    if kind in ("select", "status"):
        return {"name": str(value)}
    if kind == "multi_select":
        vals = value if isinstance(value, list) else [value]
        return [{"name": str(v)} for v in vals]
    if kind == "date":
        if isinstance(value, dict):
            return value
        if isinstance(value, (list, tuple)) and len(value) == 2:
            return {"start": str(value[0]), "end": str(value[1])}
        return {"start": str(value)}
    if kind == "people":
        vals = value if isinstance(value, list) else [value]
        return [{"object": "user", "id": str(v)} for v in vals]
    if kind == "relation":
        vals = value if isinstance(value, list) else [value]
        return [{"id": _to_uuid(str(v))} for v in vals]
    if kind == "number":
        return int(value) if isinstance(value, bool) else float(value)
    if kind == "checkbox":
        return bool(value)
    if kind in ("url", "email", "phone_number"):
        return str(value)
    return value


def _shape_props(schema: dict, props: dict, c: httpx.Client | None = None,
                 from_db: str | None = None) -> dict:
    """Plain values in, Notion's shapes out — refusing BEFORE anything is written.

    The inverse of `_flatten_props`, and written beside it on purpose: a codec
    whose halves live apart drifts.

    The capability already knows every property's type — `db-schema` reads it
    from the same data source. Making the caller repeat it turned a wrong guess
    into a 400 at write time, and a write-time 400 arrives AFTER the page body
    has been replaced. So the check moved in front of the mutation, and an
    unknown property name is refused with the near miss named.

    A value already in Notion's shape passes through untouched: existing callers
    keep working, and anything this codec cannot express stays expressible.

    With a client in hand a people column is resolved rather than trusted: the
    names `db-query` hands back become the ids Notion demands, which is what
    makes a row copied from one board writable into another.
    """
    types = schema.get("properties") or {}
    unknown = [k for k in props if k not in types]
    if unknown:
        import difflib
        hints = []
        for k in unknown:
            near = difflib.get_close_matches(k, list(types), n=1, cutoff=0.6)
            hints.append(repr(k) + (f" (did you mean {near[0]!r}?)" if near else ""))
        _die(7, "unknown_property",
             "not a property of this database: " + ", ".join(hints),
             "run `my-notion db-schema <db>` for the exact names; nothing was written")
    out = {}
    for k, v in props.items():
        kind = types[k]
        # People is the only column whose VALUE has to be resolved over the
        # network: Notion accepts only UUIDs there, while the caller holds names.
        # So this branch runs BEFORE the "already in Notion's shape" check: the
        # wrapper {"people": ["Name"]} is Notion's shape with unusable content,
        # and passing it through would hand a name to where an id is expected.
        if kind == "people" and c is not None:
            inner = v.get("people") if isinstance(v, dict) and "people" in v else v
            out[k] = {"people": _people_ids(c, inner, from_db)}
            continue
        # A value already in Notion's shape is recognised by ITS OWN TYPE KEY and
        # passes through: {"Owner": {"select": {...}}}. The check is on the type
        # key, not on "looks like a dict": {"name": "Done"} is the inside of a
        # select, not the select itself, and passing it through would hand Notion
        # an unwrapped value. That exact bug was here on the first attempt.
        if isinstance(v, dict) and kind in v:
            out[k] = v
            continue
        out[k] = {kind: _shape_value(kind, v)}
    return out


def _schema_of_data_source(c: httpx.Client, ds_id: str) -> dict:
    """Schema when the data source id is already in hand.

    A row's parent hands back a `data_source_id`, and that is NOT a database id:
    putting it through the database resolver asks Notion for a database that
    does not exist and gets a 404 that reads like a permissions problem. Two
    different ids that look alike is exactly the kind of thing a capability
    should absorb rather than pass to its caller.
    """
    ds = _request(c, "GET", f"/data_sources/{ds_id}")
    props = ds.get("properties") or {}
    return {"data_source_id": ds_id,
            "properties": {k: v.get("type") for k, v in props.items()}}


def cmd_db_schema(c: httpx.Client, db: str) -> dict:
    ds_id = _data_source_id(c, db)
    ds = _request(c, "GET", f"/data_sources/{ds_id}")
    props = ds.get("properties") or {}
    return {"data_source_id": ds_id,
            "properties": {k: v.get("type") for k, v in props.items()}}


def cmd_db_alter(c: httpx.Client, db: str, props: dict,
                 drop: bool = False) -> dict:
    """Add or change a database's COLUMNS.

    Without this, a database created once keeps the schema it was born with
    forever, while a column appears when someone learns they need it: a row
    "type" on a board was needed on day two, because bugs and decisions had
    landed in one queue with nothing to tell them apart.

    Notion merges the passed properties into the existing ones rather than
    replacing them wholesale; to REMOVE a column, pass it null. So nothing is
    subtracted here: a silently lost column is silently lost data.
    """
    ds_id = _data_source_id(c, db)

    # A GUARD THAT WAS NOT HERE, AND ITS ABSENCE COST DATA.
    #
    # Notion merges PROPERTIES, but a select's option list it REPLACES whole.
    # So a `db-alter` given a new set of statuses blanks, on every row, any
    # value missing from the new set: silently, all at once, with no error in
    # the response. On 2026-08-31 fifty-eight rows of a board lost their status
    # this way: deferred, delivered and closed became indistinguishable from
    # open. Only a markdown source lying next to it saved the day; on another
    # day nothing would have.
    #
    # So before replacing, count WHICH OF THE REMOVED options rows actually
    # hold. An option nobody uses is removed freely. An option rows hold needs
    # an explicit `--drop`: then the loss is a decision, not a side effect. The
    # check reads live data, not the schema: the schema says what is allowed
    # and nothing about what is written.
    SELECTISH = ("select", "multi_select", "status")
    cur = (_request(c, "GET", f"/data_sources/{ds_id}") or {}).get("properties") or {}
    shrinking = {}
    for name, spec in props.items():
        if not isinstance(spec, dict):
            continue
        kind = next((k for k in SELECTISH if k in spec), None)
        if not kind or name not in cur:
            continue
        old_opts = {o.get("name") for o in
                    (cur[name].get(kind) or {}).get("options", [])}
        new_opts = {o.get("name") for o in (spec.get(kind) or {}).get("options", [])}
        gone = old_opts - new_opts
        if gone:
            shrinking[name] = (kind, gone)

    if shrinking and not drop:
        in_use: dict = {}
        for row in _all_rows(c, ds_id):
            for name, (kind, gone) in shrinking.items():
                v = (row.get("properties") or {}).get(name) or {}
                held = v.get(kind)
                vals = ([held.get("name")] if isinstance(held, dict)
                        else [x.get("name") for x in held] if isinstance(held, list)
                        else [])
                for val in vals:
                    if val in gone:
                        in_use.setdefault(f"{name}={val}", 0)
                        in_use[f"{name}={val}"] += 1
        if in_use:
            _die(6, "would_erase_values",
                 "these option values are held by rows and are missing from the "
                 "new list: " + ", ".join(f"{k} ({v} rows)"
                                          for k, v in sorted(in_use.items())),
                 "Notion REPLACES a select's options rather than merging them, so "
                 "this call would blank those rows silently. Keep the old names in "
                 "the list, migrate the rows first, or pass --drop to accept the "
                 "loss deliberately.")

    data = _request(c, "PATCH", f"/data_sources/{ds_id}", {"properties": props})
    now = data.get("properties") or {}
    return {"data_source_id": ds_id, "changed": sorted(props),
            "dropped_unused": {k: sorted(v[1]) for k, v in shrinking.items()} or None,
            "properties": {k: v.get("type") for k, v in now.items()}}


def _all_rows(c: httpx.Client, ds_id: str):
    """Every row of the data source. A FULL walk is needed, not the first
    page: an option held by one row in the second hundred is exactly the case
    the check is written for."""
    cursor = None
    while True:
        body = {"page_size": 100}
        if cursor:
            body["start_cursor"] = cursor
        data = _request(c, "POST", f"/data_sources/{ds_id}/query", body)
        for r in data.get("results", []):
            yield r
        if not data.get("has_more"):
            return
        cursor = data.get("next_cursor")


def cmd_db_add(c: httpx.Client, db: str, props: dict) -> dict:
    ds_id = _data_source_id(c, db)
    props = _shape_props(cmd_db_schema(c, db), props, c, from_db=db)
    data = _request(c, "POST", "/pages", {
        "parent": {"type": "data_source_id", "data_source_id": ds_id},
        "properties": props,
    })
    return _page_summary(data, action="created")


VIEW_TYPES = ("table", "board", "calendar", "timeline", "gallery",
               "list", "map", "form", "chart")


def _view_brief(v: dict) -> dict:
    return {"id": v.get("id"), "name": v.get("name"), "type": v.get("type"),
            "parent": v.get("parent"), "url": v.get("url")}


def _group_by_block(c: httpx.Client, ds_id: str, name: str) -> dict:
    """Resolve a property NAME to the group_by block a view wants.

    Filters accept a property name and Notion resolves it, but group_by
    insists on the property id — which nobody has to hand. So the caller
    names the column and this looks the id up.
    """
    ds = _request(c, "GET", f"/data_sources/{ds_id}")
    props = ds.get("properties") or {}
    prop = props.get(name)
    if not prop:
        _die(6, "unknown_property",
             f"no property named {name!r} on this data source",
             "columns are: " + ", ".join(sorted(props)))
    # "manual" keeps whatever order a person drags the columns into, which is
    # what a board is for; Notion requires the key rather than defaulting it.
    return {"type": prop.get("type"), "property_id": prop.get("id"),
            "sort": {"type": "manual"}}


def cmd_views(c: httpx.Client, db: str) -> dict:
    """List the views defined on a database's primary data source.

    The list endpoint returns bare ids and nothing else, so each view is
    retrieved to make the answer readable. A database carries a handful of
    views, so the extra requests are cheap; a list of naked UUIDs is not an
    answer to "what views does this database have".
    """
    ds = _data_source_id(c, db)
    out = _request(c, "GET", f"/views?data_source_id={ds}")
    views = []
    for stub in (out.get("results") or []):
        vid = stub.get("id")
        if not vid:
            continue
        full = _request(c, "GET", f"/views/{vid}")
        brief = _view_brief(full)
        brief["filtered"] = bool(full.get("filter"))
        views.append(brief)
    return {"data_source_id": ds, "views": views}


def cmd_view_get(c: httpx.Client, view: str) -> dict:
    return _request(c, "GET", f"/views/{_to_uuid(view)}")


def cmd_view_create(c: httpx.Client, db: str, name: str, vtype: str,
                    page: str | None, flt: dict | None, sorts: list | None,
                    config: dict | None, quick: dict | None,
                    group_by: str | None = None) -> dict:
    """Create a view on a database, or as a linked-database block on a page.

    With --page the source database is left untouched: Notion creates a new
    linked database block on that page and hangs the view off it. Without it
    the view is appended as a tab on the database itself.
    """
    if vtype not in VIEW_TYPES:
        _die(6, "bad_view_type",
             f"unknown view type {vtype!r}",
             "one of: " + ", ".join(VIEW_TYPES))
    ds = _data_source_id(c, db)
    body: dict = {"data_source_id": ds, "name": name, "type": vtype}
    if page:
        body["create_database"] = {
            "parent": {"type": "page_id", "page_id": _to_uuid(page)}}
    else:
        body["database_id"] = _to_uuid(db)
    cfg = dict(config) if config else {}
    cfg.setdefault("type", vtype)
    if cfg.get("type") != vtype:
        _die(6, "config_type_mismatch",
             f"configuration.type {cfg['type']!r} does not match view type {vtype!r}",
             "the view type and its configuration block must agree")
    if group_by and "group_by" not in cfg:
        cfg["group_by"] = _group_by_block(c, ds, group_by)
    if vtype == "board" and not cfg.get("group_by"):
        _die(6, "board_needs_group_by",
             "a board view must say which column becomes its columns",
             "pass --group-by <property name>, e.g. --group-by Status")
    body["configuration"] = cfg
    if flt:
        body["filter"] = flt
    if sorts:
        body["sorts"] = sorts
    if quick:
        body["quick_filters"] = quick
    v = _request(c, "POST", "/views", body)
    out = _view_brief(v)
    out["placement"] = "linked block on page" if page else "tab on database"
    out["action"] = "created"
    return out


def cmd_view_update(c: httpx.Client, view: str, patch: dict) -> dict:
    if not patch:
        _die(6, "empty_patch", "nothing to update",
             "pass a JSON object, e.g. {\"name\": \"Waiting on review\"}")
    v = _request(c, "PATCH", f"/views/{_to_uuid(view)}", patch)
    out = _view_brief(v)
    out["action"] = "updated"
    return out


def cmd_view_delete(c: httpx.Client, view: str) -> dict:
    vid = _to_uuid(view)
    _request(c, "DELETE", f"/views/{vid}")
    return {"object": "view", "id": vid, "action": "deleted"}


def cmd_db_query(c: httpx.Client, db: str, flt: dict | None,
                 sorts: list | None, limit: int) -> dict:
    ds_id = _data_source_id(c, db)
    rows: list[dict] = []
    cursor: str | None = None
    while True:
        page_size = min(100, limit - len(rows)) if limit else 100
        body: dict = {"page_size": page_size}
        if flt:
            body["filter"] = flt
        if sorts:
            body["sorts"] = sorts
        if cursor:
            body["start_cursor"] = cursor
        data = _request(c, "POST", f"/data_sources/{ds_id}/query", body)
        for r in data.get("results", []):
            # A ROW'S TIMESTAMPS TRAVEL WITH ITS FIELDS. Notion stamps them
            # on every row itself; they cannot be forged by hand and never
            # collide. We used to drop them, and a row's age had to be seeded
            # from the git history of a file that was no longer the board's source.
            raw = r.get("properties", {})
            row = {"id": r.get("id"), "url": r.get("url"),
                   "created_time": r.get("created_time"),
                   "last_edited_time": r.get("last_edited_time"),
                   "properties": _flatten_props(raw)}
            # PEOPLE ALSO TRAVEL AS IDS, next to the names, not instead of
            # them: a name is what a person reads, but only an id can be written
            # back. Before they were here, a row read from one database could not
            # be written to another without a second request per person.
            people = _people_of(raw)
            if people:
                row["people"] = people
            rows.append(row)
            if limit and len(rows) >= limit:
                return {"data_source_id": ds_id, "count": len(rows), "rows": rows}
        if not data.get("has_more"):
            break
        cursor = data.get("next_cursor")
    return {"data_source_id": ds_id, "count": len(rows), "rows": rows}


def cmd_db_update(c: httpx.Client, row: str, props: dict) -> dict:
    """Update a row's properties, taking plain values.

    The schema is read from the row's OWN parent rather than asked for: a caller
    holding a row id should not also have to know which database it sits in, and
    one lookup buys a whole class of 400s that otherwise surface only at write
    time. A row whose parent is not a database is written through unchanged.
    """
    page_id = _to_uuid(row)
    parent = (_request(c, "GET", f"/pages/{page_id}").get("parent") or {})
    ds_id = parent.get("data_source_id")
    db_id = parent.get("database_id")
    if ds_id:
        props = _shape_props(_schema_of_data_source(c, ds_id), props, c,
                             from_db=db_id)
    elif db_id:
        props = _shape_props(cmd_db_schema(c, db_id), props, c, from_db=db_id)
    data = _request(c, "PATCH", f"/pages/{page_id}", {"properties": props})
    return _page_summary(data, action="updated")


def cmd_archive(c: httpx.Client, ref: str, is_database: bool,
                is_block: bool = False) -> dict:
    obj_id = _to_uuid(ref)
    # A block is deleted by its own method, not by a "to trash" flag: it has
    # no `in_trash`, and a PATCH on it silently does nothing.
    if is_block:
        _request(c, "DELETE", f"/blocks/{obj_id}")
        return {"object": "block", "id": obj_id, "action": "deleted"}
    endpoint = "databases" if is_database else "pages"
    _request(c, "PATCH", f"/{endpoint}/{obj_id}", {"in_trash": True})
    return {"object": "database" if is_database else "page",
            "id": obj_id, "action": "archived"}


def cmd_restore(c: httpx.Client, ref: str, is_database: bool,
                is_block: bool = False) -> dict:
    """Take a page, database or deleted block back out of the trash.

    The undo of `archive`: the same object comes back with its id, children
    and comments. Measured 2026-10-08: a page returns under its old parent,
    but a restored block lands at the end of its parent, not where it stood."""
    obj_id = _to_uuid(ref)
    endpoint = "blocks" if is_block else \
        "databases" if is_database else "pages"
    data = _request(c, "PATCH", f"/{endpoint}/{obj_id}", {"in_trash": False},
                    not_found_hint="no such id, or the trash was emptied: "
                                   "Notion keeps trashed pages for 30 days")
    if data.get("in_trash") or data.get("archived"):
        _die(5, "restore_did_not_take",
             f"Notion accepted the request and {obj_id} is still in the trash",
             "restore it in the app", status=200)
    return {"object": endpoint[:-1], "id": obj_id, "url": data.get("url"),
            "action": "restored"}


# --- comments and files -------------------------------------------------------
#
# Neither exists upstream, and without them a card is only text. A board that
# lives in a database needs exactly two things a markdown file never gave: a
# person marks something on a screenshot and puts it on the card, and an agent
# takes that screenshot and reads it; and a person writes a comment, and an
# agent reads it and answers in the same thread. These two follow.
#
# Comments require the integration to have the read and insert comment
# capabilities enabled. Without them Notion answers 403 restricted_resource,
# and that is NOT the same as "no comments": an empty list and a refusal must
# read differently, or we get a board that silently does not see what was
# written on it. So the refusal is raised as an error, not returned as empty.

def cmd_comments(c: httpx.Client, page: str, blocks: bool = False) -> dict:
    """A page's (or block's) comment threads, as a flat list.

    Notion files a thread on a line under that block, and `GET /comments` on
    the page does not return it, so `blocks` walks the page in document order
    and reads each block's threads too. Child pages are other pages: skipped.
    """
    block_id = _to_uuid(page)
    out = _comments_on(c, block_id)

    def walk(parent_id: str) -> None:
        for b in cmd_blocks(c, parent_id)["blocks"]:
            if b["type"] in ("child_page", "child_database"):
                continue
            for cm in _comments_on(c, b["id"]):
                out.append({**cm, "block_id": b["id"], "block_text": b["text"][:80]})
            if b["has_children"]:
                walk(b["id"])

    if blocks:
        walk(block_id)
    return {"page_id": block_id, "count": len(out), "comments": out}


def _comments_on(c: httpx.Client, block_id: str) -> list:
    out, cursor = [], None
    while True:
        q = f"/comments?block_id={block_id}&page_size=100"
        if cursor:
            q += f"&start_cursor={cursor}"
        data = _request(c, "GET", q)
        for r in data.get("results", []):
            out.append({
                "id": r.get("id"),
                "discussion_id": r.get("discussion_id"),
                "created_time": r.get("created_time"),
                "created_by": (r.get("created_by") or {}).get("id"),
                "text": "".join(t.get("plain_text", "")
                                for t in r.get("rich_text", [])),
            })
        if not data.get("has_more"):
            break
        cursor = data.get("next_cursor")
    return out


def cmd_blocks(c: httpx.Client, parent: str) -> dict:
    """Direct child blocks of a page or block, with the ids a comment anchors to."""
    parent_id = _to_uuid(parent)
    out, cursor = [], None
    while True:
        q = f"/blocks/{parent_id}/children?page_size=100"
        if cursor:
            q += f"&start_cursor={cursor}"
        data = _request(c, "GET", q)
        for b in data.get("results", []):
            body = b.get(b.get("type"), {}) or {}
            out.append({
                "id": b.get("id"),
                "type": b.get("type"),
                "text": "".join(t.get("plain_text", "")
                                for t in body.get("rich_text", []) or []),
                "has_children": b.get("has_children", False),
            })
        if not data.get("has_more"):
            break
        cursor = data.get("next_cursor")
    return {"parent_id": parent_id, "count": len(out), "blocks": out}


def cmd_comment(c: httpx.Client, page: str, text: str,
                discussion: str | None, block: str | None = None) -> dict:
    """Write a comment: a new thread on the page, or a reply in a thread.

    `--discussion` replies IN the thread instead of starting a second one next
    to it. Without it a reply to someone's question lands as a separate thread,
    and the person does not find it where they asked.
    """
    body: dict = {"rich_text": [{"text": {"content": text[i:i + 1900]}}
                                for i in range(0, len(text[:6000]), 1900)]}
    if discussion and block:
        _die(6, "input", "--discussion and --block are exclusive",
             "a reply lands in its thread's own anchor; --block starts a new "
             "thread on one block")
    if discussion:
        body["discussion_id"] = discussion
    elif block:
        body["parent"] = {"block_id": _to_uuid(block)}
    else:
        body["parent"] = {"page_id": _to_uuid(page)}
    data = _request(c, "POST", "/comments", body)
    parent = data.get("parent") or {}
    return {"id": data.get("id"), "discussion_id": data.get("discussion_id"),
            "parent": {k: v for k, v in parent.items() if k != "type"},
            "action": "commented"}


def cmd_comment_delete(c: httpx.Client, comment: str) -> dict:
    """Delete one comment, e.g. a thread left on the whole page by mistake.

    Notion lets a token delete only the comments it wrote, and answers 404 for
    anyone else's, the same as for an id that does not exist. The hint says
    both, so "not mine" is not read as "already gone".
    """
    cid = _to_uuid(comment)
    _request(c, "DELETE", f"/comments/{cid}",
             not_found_hint="no such comment, or it was written by another "
                            "token: Notion lets a token delete only its own "
                            "comments; the author's token deletes it, or a "
                            "person does in Notion")
    return {"object": "comment", "id": cid, "action": "deleted"}


def cmd_comment_edit(c: httpx.Client, comment: str, text: str) -> dict:
    """Replace the text of one comment; it stays in its thread, same id.

    As with deleting, Notion lets a token edit only the comments it wrote."""
    cid = _to_uuid(comment)
    data = _request(c, "PATCH", f"/comments/{cid}",
                    {"rich_text": _rich_text(text[:6000])},
                    not_found_hint="no such comment, or it was written by "
                                   "another token: Notion lets a token edit "
                                   "only its own comments")
    return {"object": "comment", "id": cid,
            "discussion_id": data.get("discussion_id"), "action": "edited"}


SINGLE_PART_MAX = 20 * 1024 * 1024    # Notion's ceiling for a one-shot upload
PART_SIZE = 10 * 1024 * 1024          # multi-part: 5-20 MB per part, last smaller
# Measured 2026-10-08: a free workspace refuses multi-part outright and caps a
# file at 5 MB; Notion's own message names the limit, so it is passed through.
UPLOAD_HINT = ("Notion refused the file itself: a free workspace takes files "
               "up to 5 MB and no multi-part uploads, and some extensions are "
               "not accepted; nothing was attached")


def _send_bytes(c: httpx.Client, up_id: str, name: str, ctype: str,
                payload: bytes, part: int | None = None) -> None:
    # The bytes go WITHOUT a Content-Type header: multipart sets its own, and
    # the client's application/json silently breaks the upload: the declaration
    # gets a 200 and the result is an empty file.
    r = httpx.post(f"{API_BASE}/file_uploads/{up_id}/send",
                   files={"file": (name, payload, ctype)},
                   data={"part_number": str(part)} if part else None,
                   headers={"Authorization": c.headers.get("Authorization", ""),
                            "Notion-Version": NOTION_VERSION},
                   timeout=httpx.Timeout(300.0))
    if r.status_code >= 300:
        _die(5, "upload_failed",
             f"upload{f' part {part}' if part else ''} returned {r.status_code}",
             r.text[:200])


def _upload(c: httpx.Client, src: str) -> tuple[str, str, str]:
    """Upload a local file or a public URL; return (file_upload id, name, type).

    A file over 20 MB goes in 10 MB parts, which is the only way Notion takes
    it. A URL is fetched by Notion itself (`external_url` mode), so a file in
    the cloud never passes through this machine; we wait until Notion says it
    has it, because attaching a pending upload fails.
    """
    import mimetypes, pathlib as _pl
    from urllib.parse import urlparse, unquote
    if re.match(r"https?://", src):
        name = unquote(urlparse(src).path.rsplit("/", 1)[-1]) or "file"
        ctype = mimetypes.guess_type(name)[0] or "application/octet-stream"
        up = _request(c, "POST", "/file_uploads",
                      {"mode": "external_url", "external_url": src,
                       "filename": name}, validation_hint=UPLOAD_HINT)
        up_id = up["id"]
        for _ in range(60):
            st = _request(c, "GET", f"/file_uploads/{up_id}")
            if st.get("status") == "uploaded":
                return up_id, name, st.get("content_type") or ctype
            if st.get("status") == "failed":
                res = st.get("file_import_result") or {}
                _die(5, "import_failed", f"Notion could not fetch {src}",
                     json.dumps(res.get("error") or res)[:300])
            time.sleep(2)
        _die(5, "import_timeout", f"Notion is still fetching {src} after 2 minutes",
             "try again later; nothing was attached")
    f = _pl.Path(src).expanduser()
    if not f.is_file():
        _die(6, "no_file", f"file not found: {f}")
    ctype = mimetypes.guess_type(f.name)[0] or "application/octet-stream"
    size = f.stat().st_size
    if size <= SINGLE_PART_MAX:
        up = _request(c, "POST", "/file_uploads",
                      {"mode": "single_part", "filename": f.name,
                       "content_type": ctype}, validation_hint=UPLOAD_HINT)
        _send_bytes(c, up["id"], f.name, ctype, f.read_bytes())
        return up["id"], f.name, ctype
    parts = -(-size // PART_SIZE)
    up = _request(c, "POST", "/file_uploads",
                  {"mode": "multi_part", "filename": f.name,
                   "content_type": ctype, "number_of_parts": parts},
                  validation_hint=UPLOAD_HINT)
    with f.open("rb") as fh:
        for n in range(1, parts + 1):
            _send_bytes(c, up["id"], f.name, ctype, fh.read(PART_SIZE), n)
    _request(c, "POST", f"/file_uploads/{up['id']}/complete", {})
    return up["id"], f.name, ctype


def cmd_attach(c: httpx.Client, page: str, src: str, caption: str | None,
               cover: bool = False, icon: bool = False,
               prop: str | None = None) -> dict:
    """Put a file into a page: its body (default), its cover, its icon, or a
    Files column of a database row.

    Notion takes three steps: declare the upload, send the bytes, then attach
    the finished id. In the body the block type follows the extension: an image
    shows on the card, everything else becomes a file. A picture that arrives
    as a `file` block is not visible to the eye, and the whole point of an
    attachment is that someone looks at it.
    """
    if sum(map(bool, (cover, icon, prop))) > 1:
        _die(6, "input", "--cover, --icon and --property are exclusive")
    page_id = _to_uuid(page)
    if prop:
        # Check the column before uploading: a wrong name should cost nothing.
        current = _request(c, "GET", f"/pages/{page_id}")
        col = (current.get("properties") or {}).get(prop)
        if not col or col.get("type") != "files":
            have = [k for k, v in (current.get("properties") or {}).items()
                    if v.get("type") == "files"]
            _die(6, "no_files_column", f"{prop!r} is not a Files column here",
                 f"Files columns on this row: {have or 'none'}")
    up_id, name, ctype = _upload(c, src)
    ref = {"type": "file_upload", "file_upload": {"id": up_id}}
    out = {"page_id": page_id, "file": name, "file_upload_id": up_id}
    if cover or icon:
        if icon and not ctype.startswith("image/"):
            _die(6, "not_an_image", f"an icon must be an image, {name} is {ctype}")
        _request(c, "PATCH", f"/pages/{page_id}",
                 {"cover" if cover else "icon": ref})
        return {**out, "to": "cover" if cover else "icon", "action": "attached"}
    if prop:
        # Notion replaces a Files column's whole list, so the files already in
        # it are sent back with the new one. A Notion-hosted file is sent back
        # by its (signed) url, which Notion accepts as the same file.
        kept = [{k: v for k, v in x.items() if k in ("name", "type", "file", "external")}
                for x in col.get("files", [])]
        for x in kept:
            if x.get("type") == "file":
                x["file"] = {"url": x["file"]["url"]}
        _request(c, "PATCH", f"/pages/{page_id}",
                 {"properties": {prop: {"files": kept + [{"name": name, **ref}]}}})
        return {**out, "to": f"property:{prop}", "files_now": len(kept) + 1,
                "action": "attached"}
    kind = "image" if ctype.startswith("image/") else (
        "video" if ctype.startswith("video/") else
        "pdf" if ctype == "application/pdf" else "file")
    block: dict = {"type": kind, kind: ref}
    if caption:
        block[kind]["caption"] = [{"text": {"content": caption[:1900]}}]
    _request(c, "PATCH", f"/blocks/{page_id}/children", {"children": [block]})
    return {**out, "block": kind, "action": "attached"}


def cmd_files(c: httpx.Client, page: str) -> dict:
    """A page's attachments with fresh addresses.

    Notion signs each address and it lives about an hour, so the list is built
    by a request rather than taken from storage: a stored attachment link is a
    link that will stop working, and nobody will know when.
    """
    out, cursor = [], None
    while True:
        q = f"/blocks/{_to_uuid(page)}/children?page_size=100"
        if cursor:
            q += f"&start_cursor={cursor}"
        data = _request(c, "GET", q)
        for b in data.get("results", []):
            t = b.get("type")
            if t not in ("image", "video", "pdf", "file", "audio"):
                continue
            payload = b.get(t) or {}
            src = (payload.get("file") or {}).get("url") or \
                  (payload.get("external") or {}).get("url")
            out.append({"block_id": b.get("id"), "kind": t, "url": src,
                        "caption": "".join(x.get("plain_text", "")
                                           for x in payload.get("caption", []))})
        if not data.get("has_more"):
            break
        cursor = data.get("next_cursor")
    return {"page_id": _to_uuid(page), "count": len(out), "files": out}


def cmd_download(c: httpx.Client, page: str, dest: str) -> dict:
    """Download a page's attachments into a folder, which is how an agent reads them."""
    import pathlib as _pl
    d = _pl.Path(dest).expanduser()
    d.mkdir(parents=True, exist_ok=True)
    got = []
    for f in cmd_files(c, page)["files"]:
        if not f["url"]:
            continue
        r = httpx.get(f["url"], timeout=TIMEOUT, follow_redirects=True)
        if r.status_code >= 300:
            continue
        name = f["url"].split("?")[0].rsplit("/", 1)[-1] or f["block_id"]
        out = d / name
        out.write_bytes(r.content)
        got.append({"block_id": f["block_id"], "path": str(out),
                    "bytes": len(r.content), "caption": f["caption"]})
    return {"page_id": _to_uuid(page), "saved": len(got), "files": got}


# --- CLI ---------------------------------------------------------------------

def main() -> None:
    _gate()                      # every verb passes the project gate first
    _contract(sys.argv[1:])      # contract verbs; domain verbs fall through
    p = argparse.ArgumentParser(
        prog="my-notion",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("help", help="print the full usage contract")
    sub.add_parser("doctor", help="health check: creds + reachability + identity")
    sub.add_parser("whoami", help="confirm token and return identity")

    sp = sub.add_parser("children", help="list child pages of a parent page")
    sp.add_argument("parent", help="parent page UUID or Notion URL")

    sp = sub.add_parser("get", help="fetch page body as markdown")
    sp.add_argument("page", help="page UUID or Notion URL")

    sp = sub.add_parser("append", help="add markdown to the end of a page (one request)")
    sp.add_argument("page", help="page UUID or Notion URL")
    sp.add_argument("md", nargs="?", default="-",
                    help="markdown file path or '-' for stdin (default: stdin)")

    sp = sub.add_parser("publish", help="replace body of an existing page")
    sp.add_argument("page", help="page UUID or Notion URL")
    sp.add_argument("md", nargs="?", default="-",
                    help="markdown file path or '-' for stdin (default: stdin)")

    sp = sub.add_parser("create", help="create a new page under a parent")
    sp.add_argument("--parent", required=True, help="parent page UUID or URL")
    sp.add_argument("--title", default=None,
                    help="title for the new page (optional if file has '# H1')")
    sp.add_argument("md", nargs="?", default="-",
                    help="markdown file path or '-' for stdin (default: stdin)")

    sp = sub.add_parser("upsert", help="find by title under parent, or create")
    sp.add_argument("--parent", required=True, help="parent page UUID or URL")
    sp.add_argument("--title", default=None,
                    help="exact title to match (optional if file has '# H1')")
    sp.add_argument("md", nargs="?", default="-",
                    help="markdown file path or '-' for stdin (default: stdin)")

    sp = sub.add_parser("archive", help="move a page (or --database) to trash")
    sp.add_argument("ref", help="page or database UUID or URL")
    sp.add_argument("--database", action="store_true",
                    help="treat ref as a database (default: a page)")
    sp.add_argument("--block", action="store_true",
                    help="ref is a block: delete it (e.g. an attachment)")

    sp = sub.add_parser("restore", help="take a page (or --database, --block) out of the trash")
    sp.add_argument("ref", help="page, database or block UUID or URL")
    sp.add_argument("--database", action="store_true", help="ref is a database")
    sp.add_argument("--block", action="store_true", help="ref is a deleted block")

    sp = sub.add_parser("edit", help="replace text on a page, keeping its blocks and comments")
    sp.add_argument("page", help="page UUID or Notion URL")
    sp.add_argument("--old", action="append", required=True,
                    help="text to find (exactly once); repeat with --new")
    sp.add_argument("--new", action="append", required=True,
                    help="its replacement (markdown); one per --old")
    sp.add_argument("--all", action="store_true",
                    help="replace every match, not just a single one")

    sp = sub.add_parser("insert", help="insert markdown after one line of a page")
    sp.add_argument("page", help="page UUID or Notion URL")
    sp.add_argument("--after", required=True,
                    help="text of the line to insert after, or 'start...end'")
    sp.add_argument("md", nargs="?", default="-",
                    help="markdown file path or '-' for stdin (default: stdin)")

    sp = sub.add_parser("block-update", help="rewrite one block's text by its id")
    sp.add_argument("block", help="block UUID, from `blocks`")
    sp.add_argument("text", nargs="?", default="-",
                    help="new text (inline markdown), or '-' for stdin")

    sp = sub.add_parser("search", help="find pages and databases by title")
    sp.add_argument("query", help="text in the title")
    sp.add_argument("--type", dest="kind", choices=["page", "database"],
                    default=None, help="only pages or only databases")
    sp.add_argument("--limit", type=int, default=20, help="max results (0 = all)")

    sp = sub.add_parser("db-create", help="create a database under a page")
    sp.add_argument("--parent", required=True, help="parent page UUID or URL")
    sp.add_argument("--title", default=None, help="database title")
    sp.add_argument("props", nargs="?", default="-",
                    help="JSON property-schema: literal string, file path, or '-'")

    sp = sub.add_parser("db-schema", help="show a database's property schema")
    sp.add_argument("db", help="database UUID or URL")

    sp = sub.add_parser("link", help="add a link-to-page block on a page, pointing at another page")
    sp.add_argument("parent", help="page UUID or URL that gets the link")
    sp.add_argument("target", help="page UUID or URL the link points at")

    sp = sub.add_parser("page-meta", help="move a page to another parent, or rename it")
    sp.add_argument("page", help="page UUID or URL")
    sp.add_argument("--parent", default=None,
                    help="destination page UUID or URL (moves the page's children with it)")
    sp.add_argument("--title", default=None, help="new page title")

    sp = sub.add_parser("db-meta", help="move a database to another parent, or rename it")
    sp.add_argument("db", help="database UUID or URL")
    sp.add_argument("--parent", default=None,
                    help="destination page UUID or URL (moves the rows with it)")
    sp.add_argument("--title", default=None, help="new database title")

    sp = sub.add_parser("users", help="list workspace users, or resolve one to its id")
    sp.add_argument("action", choices=["list", "get"], help="list | get")
    sp.add_argument("query", nargs="?", default=None,
                    help="for get: display name, email, or UUID")
    sp.add_argument("--from", dest="from_db", default=None,
                    help="also count whoever is assigned on this database's rows")
    sp.add_argument("--save", action="store_true",
                    help="for get: record the id in the project identifiers "
                         "envelope so it stays resolvable")

    sp = sub.add_parser("db-alter", help="add or change a database's columns")
    sp.add_argument("db", help="database UUID or URL")
    sp.add_argument("props", nargs="?", help="JSON property schema, path, or -")
    sp.add_argument("--drop", action="store_true",
                    help="accept erasing option values that rows still hold")

    sp = sub.add_parser("db-add", help="add a row to a database")
    sp.add_argument("db", help="database UUID or URL")
    sp.add_argument("props", nargs="?", default="-",
                    help="JSON property-values: literal string, file path, or '-'")

    sp = sub.add_parser("views", help="list a database's views")
    sp.add_argument("db", help="database UUID or URL")

    sp = sub.add_parser("view", help="retrieve one view")
    sp.add_argument("view", help="view UUID or URL")

    sp = sub.add_parser("view-create", help="create a view on a database or page")
    sp.add_argument("db", help="source database UUID or URL")
    sp.add_argument("--name", required=True, help="view name")
    sp.add_argument("--type", dest="vtype", required=True,
                    choices=list(VIEW_TYPES), help="view type")
    sp.add_argument("--page", default=None,
                    help="put the view on this page as a LINKED database "
                         "block; omit to add a tab on the database itself")
    sp.add_argument("--filter", default=None, help="JSON filter object")
    sp.add_argument("--sorts", default=None, help="JSON sorts array")
    sp.add_argument("--config", default=None,
                    help="JSON view configuration (group_by, properties, ...)")
    sp.add_argument("--quick-filters", dest="quick", default=None,
                    help="JSON quick-filter object pinned to the filter bar")
    sp.add_argument("--group-by", dest="group_by", default=None,
                    help="column NAME to group by (required for a board); "
                         "its property id is looked up for you")

    sp = sub.add_parser("view-update", help="update a view")
    sp.add_argument("view", help="view UUID or URL")
    sp.add_argument("patch", nargs="?", default="-",
                    help="JSON patch: literal string, file path, or '-'")

    sp = sub.add_parser("view-delete", help="delete a view")
    sp.add_argument("view", help="view UUID or URL")

    sp = sub.add_parser("db-query", help="query rows of a database")
    sp.add_argument("db", help="database UUID or URL")
    sp.add_argument("--filter", default=None, help="JSON filter object")
    sp.add_argument("--sorts", default=None, help="JSON sorts array")
    sp.add_argument("--limit", type=int, default=0, help="max rows (0 = all)")

    sp = sub.add_parser("comments", help="read comment threads on a page")
    sp.add_argument("page", help="page UUID or Notion URL")
    sp.add_argument("--blocks", action="store_true",
                    help="also read the threads on every block of the page")

    sp = sub.add_parser("comment", help="write a comment on a page or into a thread")
    sp.add_argument("page", help="page UUID or Notion URL")
    sp.add_argument("text", help="comment text")
    sp.add_argument("--discussion", help="reply into this discussion_id")
    sp.add_argument("--block", help="anchor the new thread on this block id")

    sp = sub.add_parser("comment-delete", help="delete one comment this token wrote")
    sp.add_argument("comment", help="comment id, from `comments`")

    sp = sub.add_parser("comment-edit", help="replace the text of one comment this token wrote")
    sp.add_argument("comment", help="comment id, from `comments`")
    sp.add_argument("text", help="new comment text")

    sp = sub.add_parser("blocks", help="list a page's or block's child blocks")
    sp.add_argument("page", help="page or block UUID or Notion URL")

    sp = sub.add_parser("attach", help="put a file into a page's body, cover, icon or Files column")
    sp.add_argument("page", help="page UUID or Notion URL")
    sp.add_argument("file", help="local path, or a public http(s) URL Notion fetches")
    sp.add_argument("--caption", help="caption under the block")
    sp.add_argument("--cover", action="store_true", help="make it the page cover")
    sp.add_argument("--icon", action="store_true", help="make it the page icon (an image)")
    sp.add_argument("--property", dest="prop", default=None,
                    help="add it to this Files column of a database row")

    sp = sub.add_parser("files", help="list a page's attachments with fresh URLs")
    sp.add_argument("page", help="page UUID or Notion URL")

    sp = sub.add_parser("download", help="save a page's attachments to a directory")
    sp.add_argument("page", help="page UUID or Notion URL")
    sp.add_argument("dest", nargs="?", default=".", help="target directory")

    sp = sub.add_parser("db-update", help="update a row's properties")
    sp.add_argument("row", help="row (page) UUID or URL")
    sp.add_argument("props", nargs="?", default="-",
                    help="JSON property-values: literal string, file path, or '-'")

    # `--token-env <KEY>` is a global override accepted anywhere on the line
    # (extracted before argparse so it works after the subcommand, e.g.
    # `my-notionpublish <page> --token-env NOTION_ALT_TOKEN`). It names the env/cred
    # key holding the PAT to act as — never the token value itself.
    argv = sys.argv[1:]
    token_key: str | None = None     # --token-env override; None = not passed
    wanted_conn: str | None = None   # --connection; both accepted anywhere on argv
    cleaned: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--token-env" and i + 1 < len(argv):
            token_key = argv[i + 1]; i += 2; continue
        if a.startswith("--token-env="):
            token_key = a.split("=", 1)[1]; i += 1; continue
        if a == "--connection" and i + 1 < len(argv):
            wanted_conn = argv[i + 1]; i += 2; continue
        if a.startswith("--connection="):
            wanted_conn = a.split("=", 1)[1]; i += 1; continue
        cleaned.append(a); i += 1

    args = p.parse_args(cleaned)

    if args.cmd == "help":
        sys.stdout.write((__doc__ or "").lstrip("\n"))
        return

    reg, _ = _connections_registry()
    if args.cmd == "doctor":
        cmd_doctor(reg, wanted_conn, token_key)
        return

    cid, entry = _select_connection(reg, wanted_conn)
    allow_write = WRITE_DEFAULT if entry is None else \
        bool(entry.get("allow_write", WRITE_DEFAULT))
    _write_gate(cid, allow_write, args.cmd)
    if entry is None:
        token = _load_token(token_key or "NOTION_TOKEN")
    else:
        key = token_key or entry.get("secret_env")
        if not key:
            _die(6, "no_secret_env", f"connection {cid!r} is missing 'secret_env'")
        token = _load_token(key)

    with _client(token) as c:
        if args.cmd == "whoami":
            _emit(cmd_whoami(c))
        elif args.cmd == "children":
            _emit(cmd_children(c, args.parent))
        elif args.cmd == "get":
            _emit(cmd_get(c, args.page))
        elif args.cmd == "append":
            _emit(cmd_append(c, args.page, _read_md(args.md)))
        elif args.cmd == "publish":
            _emit(cmd_publish(c, args.page, _read_md(args.md)))
        elif args.cmd == "create":
            _emit(cmd_create(c, args.parent, args.title, _read_md(args.md)))
        elif args.cmd == "upsert":
            _emit(cmd_upsert(c, args.parent, args.title, _read_md(args.md)))
        elif args.cmd == "archive":
            _emit(cmd_archive(c, args.ref, args.database,
                              getattr(args, "block", False)))
        elif args.cmd == "restore":
            _emit(cmd_restore(c, args.ref, args.database, args.block))
        elif args.cmd == "edit":
            if len(args.old) != len(args.new):
                _die(6, "input", "every --old needs its own --new",
                     f"got {len(args.old)} --old and {len(args.new)} --new")
            _emit(cmd_edit(c, args.page, list(zip(args.old, args.new)), args.all))
        elif args.cmd == "insert":
            _emit(cmd_insert(c, args.page, args.after, _read_md(args.md)))
        elif args.cmd == "block-update":
            _emit(cmd_block_update(c, args.block, _read_md(args.text)))
        elif args.cmd == "search":
            _emit(cmd_search(c, args.query, args.kind, args.limit))
        elif args.cmd == "db-create":
            _emit(cmd_db_create(c, args.parent, args.title, _read_json(args.props)))
        elif args.cmd == "db-schema":
            _emit(cmd_db_schema(c, args.db))
        elif args.cmd == "db-add":
            _emit(cmd_db_add(c, args.db, _read_json(args.props)))
        elif args.cmd == "link":
            _emit(cmd_link(c, args.parent, args.target))
        elif args.cmd == "page-meta":
            _emit(cmd_page_meta(c, args.page, args.parent, args.title))
        elif args.cmd == "db-meta":
            _emit(cmd_db_meta(c, args.db, args.parent, args.title))
        elif args.cmd == "users":
            _emit(cmd_users(c, args.action, args.query,
                            args.from_db, args.save))
        elif args.cmd == "db-alter":
            _emit(cmd_db_alter(c, args.db, _read_json(args.props),
                               getattr(args, "drop", False)))
        elif args.cmd == "views":
            _emit(cmd_views(c, args.db))
        elif args.cmd == "view":
            _emit(cmd_view_get(c, args.view))
        elif args.cmd == "view-create":
            _emit(cmd_view_create(
                c, args.db, args.name, args.vtype, args.page,
                json.loads(args.filter) if args.filter else None,
                json.loads(args.sorts) if args.sorts else None,
                json.loads(args.config) if args.config else None,
                json.loads(args.quick) if args.quick else None,
                args.group_by))
        elif args.cmd == "view-update":
            _emit(cmd_view_update(c, args.view, _read_json(args.patch)))
        elif args.cmd == "view-delete":
            _emit(cmd_view_delete(c, args.view))
        elif args.cmd == "db-query":
            flt = json.loads(args.filter) if args.filter else None
            sorts = json.loads(args.sorts) if args.sorts else None
            _emit(cmd_db_query(c, args.db, flt, sorts, args.limit))
        elif args.cmd == "db-update":
            _emit(cmd_db_update(c, args.row, _read_json(args.props)))
        elif args.cmd == "comments":
            _emit(cmd_comments(c, args.page, args.blocks))
        elif args.cmd == "comment":
            _emit(cmd_comment(c, args.page, args.text, args.discussion,
                              args.block))
        elif args.cmd == "comment-delete":
            _emit(cmd_comment_delete(c, args.comment))
        elif args.cmd == "comment-edit":
            _emit(cmd_comment_edit(c, args.comment, args.text))
        elif args.cmd == "blocks":
            _emit(cmd_blocks(c, args.page))
        elif args.cmd == "attach":
            _emit(cmd_attach(c, args.page, args.file, args.caption,
                             args.cover, args.icon, args.prop))
        elif args.cmd == "files":
            _emit(cmd_files(c, args.page))
        elif args.cmd == "download":
            _emit(cmd_download(c, args.page, args.dest))


if __name__ == "__main__":
    main()
