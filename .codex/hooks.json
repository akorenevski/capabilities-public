{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/bin/bash -lc 'root=$(git rev-parse --show-toplevel 2>/dev/null || pwd); /bin/bash \"$root/.codex/hooks/build-context.sh\"'",
            "statusMessage": "Regenerating ContextKit context",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ]
  }
}
