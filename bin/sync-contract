#!/usr/bin/env bash
# Bring every capabilities/*/bin/* script to the manager's contract form.
#
# The shared code is the capabilities-contract library's, bound by a version
# range (manager change log 2026-10-21): a script declares the library in its
# PEP 723 header by the range the installed manager supports and binds each tier
# it carries with `_contract_bind(globals(), "<tier>")`. The manager's own
# `sync-contract` is gone, and install, update and audit refuse an exact pin
# older than the range or a script that still carries the stamped regions
# instead of the binds. This wrapper rewrites both: each stamped
# `# >>> contract: <tier>` region becomes its bind call (the library executes
# the tier in place, as the stamped text ran), and the declared library becomes
# the manager's range. A script that declares a higher floor under the same
# ceiling keeps it, as the manager accepts any range that admits nothing older
# than its own floor: a capability that needs a newer library (telegram-bot
# needs 0.18, the first whose verb gate refuses `connections show --reveal`)
# says so in its header.
#
# Usage: bin/sync-contract [--check]   (--check: report drift, exit 7, write nothing)
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
manager="$(readlink -f "$(command -v capabilities)")"

python3 - "$manager" "$root" "$@" <<'PY'
import json, pathlib, re, sys
manager, root, args = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3:]
check = "--check" in args
lib = "capabilities-contract"
want_range = re.search(r'^CONTRACT_LIBRARY_RANGE = "([^"]+)"$', manager.read_text(), re.M).group(1)
want = f'"{lib}{want_range}"'
dep_re = re.compile(r'"capabilities-contract(?:[<>=!~][^"]*)?"')
tiers = {"capability core": "core", "store": "store", "connections": "connections"}
region_re = re.compile(r"^# >>> contract: (capability core|store|connections) .*?\n.*?^# <<< contract: \1 <<<\n",
                       re.M | re.S)
import_line = "from capabilities_contract.capability import bind as _contract_bind\n"
drift = {}
for script in sorted(root.glob("capabilities/*/bin/*")):
    name = script.parent.parent.name
    if script.name != name or not script.is_file():
        continue
    text = new = script.read_text()
    first = True
    def bind(m):
        global first
        call = f'_contract_bind(globals(), "{tiers[m.group(1)]}")\n'
        if first and import_line not in new:
            first = False
            return ("# The shared capability code is the capabilities-contract library's, bound here\n"
                    "# into this script's namespace (SHEBANG.md, \"The contract verbs\").\n"
                    + import_line + "\n" + call)
        first = False
        return call
    new = region_re.sub(bind, new)
    meta = re.search(r"^# /// script\n(.*?)^# ///$", new, re.M | re.S)
    if not meta:
        drift[name] = "no PEP 723 block"
        continue
    block = meta.group(1)
    declared = dep_re.search(block)
    def version(text):
        return tuple(int(part) for part in text.split("."))
    def bound(spec, op):
        found = re.search(op + r"([0-9.]+)", spec)
        return found.group(1) if found else None
    raised = False
    if declared:
        have = declared.group(0)
        hf, nf = bound(have, ">="), bound(want_range, ">=")
        hc, nc = bound(have, "<"), bound(want_range, "<")
        raised = bool(hf and nf and hc and hc == nc and version(hf) > version(nf))
    if declared and raised:
        new_block = block
    elif declared:
        new_block = dep_re.sub(want, block)
    elif "# dependencies = [\n" in block:
        new_block = block.replace("# dependencies = [\n", f"# dependencies = [\n#     {want},\n", 1)
    else:
        new_block = block + f"# dependencies = [\n#     {want},\n# ]\n"
    new = new[:meta.start(1)] + new_block + new[meta.end(1):]
    if new != text:
        drift[name] = "rewritten" if not check else "behind"
        if not check:
            script.write_text(new)
print(json.dumps({"contract_range": f"{lib}{want_range}", "drift" if check else "rewritten": sorted(drift)}))
sys.exit(7 if check and drift else 0)
PY
